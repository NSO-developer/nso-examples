          }
        }
        leaf soft-reconfig-backup {
          type empty;
        }
        container nexthop {
          leaf route-map {
            type string;
          }
          container trigger {
            leaf delay {
              type uint8;
            }
            leaf enable {
              type boolean;
            }
          }
        }
        leaf scan-time {
          type uint8;
        }
        list inject-map {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          key "name";
