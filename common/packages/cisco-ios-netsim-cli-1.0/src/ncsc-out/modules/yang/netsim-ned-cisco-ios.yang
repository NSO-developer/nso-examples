  grouping router-ospf-common-grouping {
    list area {
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      key "id";
      leaf id {
        tailf:cli-suppress-range;
        type ospf-area-type;
      }
      container authentication {
        tailf:cli-delete-when-empty;
        presence "true";
        leaf message-digest {
          type empty;
        }
        choice authentication-choice {
          leaf null {
            type empty;
          }
          leaf key-chain {
            type string;
          }
        }
      }
      container nssa {
        tailf:cli-compact-syntax;
        presence "true";
        leaf no-redistribution {
          type empty;
        }
        leaf default-information-originate {
          type empty;
        }
        leaf metric {
          type uint32;
        }
        leaf metric-type {
          type ospf-metric-type;
        }
        leaf nssa-only {
          type empty;
        }
        leaf no-ext-capability {
          type empty;
        }
        leaf no-summary {
          type empty;
        }
        container translate {
          container type7 {
            tailf:cli-compact-syntax;
            leaf always {
              type empty;
            }
            leaf suppress-fa {
              type empty;
            }
          }
        }
      }
      leaf default-cost {
        type uint32;
      }
      list filter-list {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        key "direction";
        leaf direction {
          type enumeration {
            enum "in";
            enum "out";
          }
        }
        leaf prefix {
          tailf:cli-prefix-key;
          type string;
        }
      }
      list range {
        tailf:cli-suppress-mode;
        tailf:cli-compact-syntax;
        key "ip mask";
        leaf ip {
          type inet:ipv4-address;
        }
        leaf mask {
          type inet:ipv4-address;
        }
        leaf advertise {
          tailf:cli-drop-node-name;
          type enumeration {
            enum "advertise";
            enum "not-advertise";
          }
        }
        leaf cost {
          type uint32;
        }
      }
      container range-ipv6 {
        tailf:cli-drop-node-name;
        list range {
          tailf:cli-compact-syntax;
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "prefix";
          leaf prefix {
            type ipv6-prefix;
          }
          leaf advertise {
            tailf:cli-drop-node-name;
            type enumeration {
              enum "advertise";
              enum "not-advertise";
            }
          }
          leaf cost {
            type uint32;
          }
        }
      }
      list sham-link {
        tailf:cli-suppress-mode;
        tailf:cli-compact-syntax;
        key "source dest";
        leaf source {
          type inet:ipv4-address;
        }
        leaf dest {
          type inet:ipv4-address;
        }
        leaf cost {
          type uint16;
        }
        container ttl-security {
          tailf:cli-flatten-container;
          tailf:cli-compact-syntax;
          leaf hops {
            type uint8;
          }
        }
      }
      container stub {
        tailf:cli-compact-syntax;
        presence "true";
        leaf no-summary {
          type empty;
        }
        leaf no-ext-capability {
          type empty;
        }
      }
      list virtual-link {
        tailf:cli-suppress-mode;
        tailf:cli-compact-syntax;
        key "id";
        leaf id {
          type inet:ipv4-address;
        }
        leaf retransmit-interval {
          type uint16;
        }
        leaf transmit-delay {
          type uint16;
        }
        leaf hello-interval {
          type int32;
        }
        leaf dead-interval {
          type uint16;
        }
        leaf authentication {
          type empty;
        }
        container authentication-key {
          tailf:cli-flatten-container;
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          // NCS expand uses statement
          leaf type {
            tailf:cli-drop-node-name;
            tailf:cli-optional-in-sequence;
            type enumeration {
              enum "0";
              enum "5";
              enum "6";
              enum "7";
            }
          }
          leaf secret {
            tailf:cli-drop-node-name;
            type string;
          }
        }
        list message-digest-key {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-compact-syntax;
          key "id";
          leaf id {
            tailf:cli-suppress-range;
            type uint8;
          }
          container md5 {
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            leaf auth-type {
              tailf:cli-drop-node-name;
              tailf:cli-optional-in-sequence;
              type uint8;
            }
            leaf auth-key {
              tailf:cli-drop-node-name;
              type string;
            }
          }
        }
      }
    }
    container auto-cost {
      leaf reference-bandwidth {
        type uint32;
      }
    }
    container bfd {
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-siblings;
      }
      leaf all-interfaces {
        type empty;
      }
      leaf strict-mode {
        type empty;
      }
    }
    container interface-id {
      leaf snmp-if-index {
        type empty;
      }
    }
    container log-adjacency-changes {
      presence "true";
      leaf detail {
        type empty;
      }
    }
    container max-lsa {
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-all-siblings;
      }
      leaf maximum-number {
        tailf:cli-drop-node-name;
        type uint32;
      }
      leaf threshold-percentage {
        tailf:cli-break-sequence-commands;
        tailf:cli-drop-node-name;
        type uint8;
      }
      leaf warning-only {
        type empty;
      }
      leaf ignore-time {
        type uint32;
      }
      leaf reset-time {
        type uint32;
      }
      leaf ignore-count {
        type uint32;
      }
    }
    uses passive-interface-grouping;
    container queue-depth {
      leaf hello {
        type union {
          type uint32;
          type enumeration {
            enum "unlimited";
          }
        }
      }
      leaf update {
        type union {
          type uint32;
          type enumeration {
            enum "unlimited";
          }
        }
      }
    }
    container timers {
      container lsa {
        leaf arrival {
          type uint32;
        }
      }
      container pacing {
        leaf flood {
          type uint32;
        }
        leaf lsa-group {
          type uint32;
        }
        leaf retransmission {
          type uint32;
        }
      }
      container spf {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        leaf spf-start {
          tailf:cli-drop-node-name;
          type uint32;
        }
        leaf spf-hold {
          tailf:cli-drop-node-name;
          type uint32;
        }
      }
      container throttle {
        container lsa {
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          leaf all {
            tailf:cli-optional-in-sequence;
            type empty;
          }
          leaf start-interval {
            tailf:cli-drop-node-name;
            type uint32;
          }
          leaf hold-interval {
            tailf:cli-drop-node-name;
            type uint32;
          }
          leaf max-interval {
            tailf:cli-drop-node-name;
            type uint32;
          }
        }
        container spf {
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          leaf spf-start {
            tailf:cli-drop-node-name;
            type uint32;
          }
          leaf spf-hold {
            tailf:cli-drop-node-name;
            type uint32;
          }
          leaf spf-max-wait {
            tailf:cli-drop-node-name;
            type uint32;
          }
        }
      }
    }
    leaf priority {
      type uint8;
    }
    leaf router-id {
      type inet:ipv4-address;
    }
  }

  grouping router-ospf-grouping {
    container capability {
