      leaf type {
        tailf:cli-optional-in-sequence;
        tailf:cli-prefix-key;
        type enumeration {
          enum "access-control";
          enum "inspect";
          enum "logging";
          enum "port-filter";
          enum "queue-threshold";
          enum "stack";
          enum "appnav";
          enum "multicast-flows";
