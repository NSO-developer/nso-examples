              enum "stag-vlan-id";
              enum "tunnel-name";
              enum "unauthenticated-domain";
              enum "unauthenticated-username";
              enum "vc-id";
              enum "vendor-class-id";
            }
          }
          leaf plus {
            type enumeration {
              enum "circuit-id";
              enum "ctag-cos";
              enum "ctag-vlan-id";
              enum "hostname";
              enum "nas-port";
              enum "payload-etype";
              enum "peer-ip-address";
              enum "remote-id";
              enum "stag-cos";
              enum "stag-type";
              enum "stag-vlan-id";
              enum "vc-id";
              enum "vendor-class-id";
            }
          }
        }
      }
      container authenticate {
        container aaa {
          leaf list {
            type union {
              type enumeration {
                enum "default";
