            type inet:ipv6-address;
          }
        }
      }
      list instance-id {
        key "id";
        leaf id {
          type uint32;
        }
        container enterprise-prefix {
          leaf prefix-list {
            type string;
          }
          container ipv4 {
            leaf prefix-list {
              type string;
            }
          }
          container ipv6 {
            leaf prefix-list {
              type string;
            }
          }
        }
      }
      leaf shutdown {
        type empty;
      }
    }
    container mka {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      list policy {
        key "name";
        leaf name {
          type string;
        }
        container key-server {
          leaf priority {
            type uint8;
          }
        }
        leaf-list macsec-cipher-suite {
          tailf:cli-flat-list-syntax;
          ordered-by user;
