        list dscp {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          key "values";
          leaf values {
            type ncs_rpc_notif_dscp-type;
          }
          uses ncs_rpc_notif_random-detect-values-grouping;
        }
      }
    }
    container queue-limit {
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands;
      container percent {
        tailf:cli-optional-in-sequence;
        leaf value {
          tailf:cli-drop-node-name;
          type ncs_rpc_notif_percentage-type;
        }
      }
      leaf queue-limit-value {
        tailf:cli-drop-node-name;
        tailf:cli-optional-in-sequence;
        type uint32;
      }
      leaf queue-limit-type {
        tailf:cli-drop-node-name;
        tailf:cli-optional-in-sequence;
        type enumeration {
          enum "bytes";
          enum "ms";
          enum "us";
          enum "packets";
        }
      }
      list dscp {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "dscp";
        leaf dscp {
          type ncs_rpc_notif_dscp-type;
        }
        leaf percent {
          type ncs_rpc_notif_percentage-type;
        }
        container absolute {
          tailf:cli-drop-node-name;
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          leaf value {
            tailf:cli-drop-node-name;
            type uint32;
          }
          leaf type {
            tailf:cli-drop-node-name;
            type enumeration {
              enum "bytes";
              enum "ms";
              enum "us";
              enum "packets";
            }
          }
        }
      }
    }
    container set {
      leaf atm-clp {
        type empty;
      }
      container cos {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        choice cos-type {
          case a {
            leaf val {
              tailf:cli-drop-node-name;
              type uint16;
            }
          }
          case b {
            leaf pack {
              tailf:cli-drop-node-name;
              type enumeration {
                enum "dscp" {
                  tailf:code-name "pack_dscp";
                }
                enum "precedence" {
                  tailf:code-name "pack_precedence";
                }
                enum "cos";
                enum "qos-group";
              }
            }
            leaf table {
              type string;
            }
          }
        }
      }
      container cos-inner {
        leaf val {
          tailf:cli-drop-node-name;
          type uint16;
        }
      }
      leaf discard-class {
        type uint16;
      }
      container dscp {
        leaf tunnel {
          type ncs_rpc_notif_dscp-type;
        }
        choice dscp-choice {
          leaf value {
            tailf:cli-drop-node-name;
            type ncs_rpc_notif_dscp-type;
          }
          container dscp {
            leaf table {
              type string;
            }
          }
        }
      }
      leaf fr-de {
        type empty;
      }
      container ip {
        choice ip-choice {
          leaf dscp {
            type ncs_rpc_notif_dscp-type;
          }
          container precedence {
            presence "Set IP precedence";
            leaf precedence-val {
              tailf:cli-drop-node-name;
              type ncs_rpc_notif_precedence-type;
            }
          }
        }
      }
      container ipv4 {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        choice ipv4-choice {
          leaf global {
            type empty;
          }
          leaf vrf {
            type string;
          }
        }
        leaf-list next-hop {
          tailf:cli-flat-list-syntax;
          ordered-by user;
          type inet:ipv4-address;
        }
      }
      container mpls {
        container experimental {
          leaf exp-value {
            tailf:cli-drop-node-name;
            type uint8;
          }
          container imposition {
            leaf exp-value {
              tailf:cli-drop-node-name;
              type uint8;
            }
          }
          container topmost {
            choice topmost-choice {
              leaf exp-value {
                tailf:cli-drop-node-name;
                type uint8;
              }
              container qos-group {
                tailf:cli-delete-when-empty;
                presence "true";
                leaf table {
                  type string;
                }
              }
            }
          }
        }
      }
      container qos-group {
        leaf qos-group-value {
          tailf:cli-drop-node-name;
          type uint8;
        }
      }
      container precedence {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        choice precedence-choice {
          case precedence-value {
            leaf precedence-value {
              tailf:cli-drop-node-name;
              tailf:cli-no-keyword;
              type ncs_rpc_notif_precedence-type;
            }
          }
          case precedence-from-field {
            leaf from-field {
              tailf:cli-drop-node-name;
              tailf:cli-no-keyword;
              type enumeration {
                enum "cos";
                enum "qos-group";
              }
            }
            leaf table {
              type string;
            }
          }
        }
      }
    }
    leaf service-policy {
      type string;
    }
    container service-policy-inspect {
      tailf:cli-drop-node-name;
      container service-policy {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        leaf dpi {
          tailf:cli-drop-node-name;
          type enumeration {
            enum "avc";
            enum "gtpv0";
            enum "gtpv1";
            enum "http";
            enum "imap";
            enum "pop3";
            enum "smtp";
            enum "sunrpc";
          }
        }
        leaf name {
          tailf:cli-drop-node-name;
          type string;
        }
      }
    }
    leaf trust {
      type enumeration {
        enum "cos";
        enum "dscp";
        enum "ip-precedence";
      }
    }
    container distribute {
      list service-node-group {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "name";
        leaf name {
          type string;
        }
      }
    }
    leaf monitor-load {
      type enumeration {
        enum "MS-port-mapper";
        enum "cifs";
        enum "http";
        enum "ica";
        enum "mapi";
        enum "nfs";
        enum "ssl";
        enum "video";
        enum "ice";
      }
    }
    leaf direct-cloud-access {
      type empty;
    }
  }

  grouping ncs_rpc_notif_policy-map-type-control-class-grouping {
