            type string;
          }
          leaf address {
            type union {
              type inet:ipv4-address;
              type inet:ipv6-address;
            }
          }
        }
        container interface {
          uses interface-name-grouping;
        }
      }
      container resolver {
        container source-interface {
          uses interface-name-grouping;
        }
      }
    }
    container dns {
      container forwarding {
        container source-interface {
          uses interface-name-grouping;
        }
      }
    }
