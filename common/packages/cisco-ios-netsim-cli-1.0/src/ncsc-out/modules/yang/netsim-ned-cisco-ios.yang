          type string;
        }
        leaf state {
          type enumeration {
            enum "active";
            enum "suspend";
          }
        }
        leaf shutdown {
          type empty;
        }
        leaf media {
          type enumeration {
            enum "ethernet";
            enum "fd-net";
            enum "fddi";
            enum "tokenring";
            enum "tr-net";
