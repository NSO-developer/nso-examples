          enum "protect";
          enum "replace";
          enum "restrict";
          enum "shutdown";
        }
      }
    }
    container mac {
      list access-group {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        key "direction";
        leaf direction {
          type enumeration {
            enum "in";
            enum "out";
          }
        }
        leaf access-list {
          tailf:cli-drop-node-name;
          tailf:cli-prefix-key;
          type string;
        }
      }
    }
    container rmon {
      leaf promiscuous {
        type empty;
      }
      container collection {
        list stats {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "id";
          leaf id {
            type uint16;
          }
          leaf owner {
            type string;
          }
        }
      }
    }
    container spanning-tree-enable {
      tailf:cli-drop-node-name;
      leaf spanning-tree {
        type empty;
      }
    }
    container spanning-tree {
      leaf bpdufilter {
        type enumeration {
          enum "disable";
          enum "enable";
        }
      }
      container bpduguard {
        choice bpduguard-choice {
          leaf disable {
            type empty;
          }
          leaf enable {
            type empty;
          }
        }
      }
      leaf cost {
