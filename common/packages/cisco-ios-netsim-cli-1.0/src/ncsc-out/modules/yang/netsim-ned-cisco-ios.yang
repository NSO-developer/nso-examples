    container l2 {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      leaf router-id {
        type inet:ipv4-address;
      }
      list vfi {
        key "name";
        leaf name {
          type string;
        }
        leaf point-to-point {
          tailf:cli-hide-in-submode;
          type empty;
        }
        leaf manual {
          tailf:cli-hide-in-submode;
          type empty;
        }
        leaf autodiscovery {
          tailf:cli-hide-in-submode;
          type empty;
        }
        leaf evc {
          tailf:cli-drop-node-name;
          tailf:cli-hide-in-submode;
          type string;
        }
        container vpn {
          leaf id {
            type uint32;
          }
        }
        leaf vpls-id {
          type string;
        }
        leaf bridge-domain {
          type uint16;
        }
        container bridge-domain-vlan {
          tailf:cli-drop-node-name;
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          leaf bridge-domain {
            type uint16;
          }
          leaf vlan {
            type empty;
          }
        }
        leaf mtu {
          type uint16;
        }
        leaf rd {
          type rd-type;
        }
        container route-target {
          uses route-target-grouping;
        }
        container neighbor-vfi {
          tailf:cli-drop-node-name;
          list neighbor {
            key "id vcid";
            leaf id {
              type inet:ipv4-address;
            }
            leaf vcid {
              type uint32;
            }
            uses l2-vfi-grouping;
          }
        }
        list neighbor {
          key "id";
          leaf id {
            type inet:ipv4-address;
          }
          uses l2-vfi-grouping;
        }
      }
    }
    list pseudowire-class {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../ncs:module) or ../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      key "name";
      leaf name {
        type string;
      }
      leaf encapsulation {
        type enumeration {
          enum "l2tpv2";
          enum "l2tpv3";
          enum "mpls";
          enum "udp";
        }
      }
      leaf interworking {
        type enumeration {
          enum "ethernet";
          enum "ip";
          enum "vlan";
        }
      }
      leaf control-word {
        type empty;
      }
      container sequencing {
        choice sequencing-choice {
          leaf both {
            type empty;
          }
          leaf receive {
            type empty;
          }
          container resync {
            presence "true";
          }
          leaf transmit {
            type empty;
          }
        }
      }
      container protocol {
        choice protocol-choice {
          leaf none {
            type empty;
          }
          leaf l2tpv2 {
            type string;
          }
          leaf l2tpv3 {
            type string;
          }
        }
      }
      container status {
        container peer {
          container topology {
            leaf dual-homed {
              type empty;
            }
          }
        }
        container protocol {
          container notification {
            leaf static {
              type string;
            }
          }
        }
      }
      container ip {
        leaf protocol {
          type enumeration {
            enum "l2tp";
            enum "uti";
          }
        }
        container local {
          container interface {
            tailf:cli-compact-syntax;
            uses interface-name-grouping;
          }
        }
        container pmtu {
          tailf:cli-delete-when-empty;
          presence "true";
          leaf max {
            type uint16;
          }
        }
        container tos {
          leaf value {
            type uint8;
          }
        }
        leaf ttl {
          type uint8;
        }
      }
      uses pseudowire-preferred-path-grouping;
    }
    container device-tracking {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      container tracking {
        presence "true";
        container auto-source {
          tailf:cli-compact-syntax;
          tailf:cli-delete-when-empty;
          presence "true";
          container fallback {
            tailf:cli-flatten-container;
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands;
            leaf address {
              tailf:cli-drop-node-name;
              type inet:ipv4-address;
            }
            leaf mask {
              tailf:cli-drop-node-name;
              type inet:ipv4-address;
            }
          }
          leaf override {
            type empty;
          }
        }
        leaf retry-interval {
          type uint16;
        }
      }
      container logging {
        container packet {
          leaf drop {
            type boolean;
          }
        }
        leaf theft {
          type boolean;
        }
        leaf resolution-veto {
          type boolean;
        }
      }
      list policy {
        key "name";
        leaf name {
          type string;
        }
        leaf trusted-port {
          type empty;
        }
        leaf security-level {
          type enumeration {
            enum "glean";
            enum "guard";
            enum "inspect";
          }
        }
        container limit {
          leaf address-count {
            type uint16;
          }
        }
        leaf device-role {
          type enumeration {
            enum "node";
            enum "switch";
          }
        }
        container protocol {
          leaf ndp {
            type boolean;
          }
          leaf arp {
            type boolean;
          }
          leaf dhcp6 {
            type boolean;
          }
          leaf udp {
            type boolean;
          }
        }
        container tracking {
          choice tracking-choice {
            leaf disable {
              type empty;
            }
            container enable {
              tailf:cli-delete-when-empty;
              presence "true";
              leaf reachable-lifetime {
                type union {
                  type uint32;
                  type enumeration {
                    enum "infinite";
                  }
                }
              }
            }
          }
        }
      }
