            enum "gcm-aes-128";
            enum "gcm-aes-256";
            enum "gcm-aes-xpn-256";
          }
        }
        leaf confidentiality-offset {
          type enumeration {
            enum "0";
            enum "30";
            enum "50";
          }
        }
        container sak-rekey {
          leaf interval {
            type uint16;
          }
          leaf on-live-peer-loss {
            type empty;
          }
        }
        leaf send-secure-announcements {
          type empty;
        }
        leaf ssci-based-on-sci {
          type empty;
        }
        leaf include-icv-indicator {
          type boolean;
        }
        leaf use-updated-eth-header {
          type empty;
        }
