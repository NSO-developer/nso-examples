              uses pm-dm-x-grouping;
            }
          }
        }
      }
      list interface {
        key "name";
        leaf name {
          type string;
        }
        container delay-measurement {
          tailf:cli-add-mode;
          presence "true";
          leaf advertise-delay {
            type uint32;
          }
          leaf profile {
            type string;
          }
        }
        container next-hop {
          choice address-choice {
            leaf ipv4 {
              type inet:ipv4-address;
            }
            leaf ipv6 {
              type inet:ipv6-address;
            }
          }
        }
      }
      list endpoint {
        key "name";
        leaf name {
          type string;
        }
        container source-address {
          choice address-choice {
            leaf ipv4 {
              type inet:ipv4-address;
            }
            leaf ipv6 {
              type inet:ipv6-address;
            }
          }
        }
        container destination-address {
          choice address-choice {
            leaf ipv4 {
              type inet:ipv4-address;
            }
            leaf ipv6 {
              type inet:ipv6-address;
            }
          }
        }
        container delay-measurement {
          tailf:cli-add-mode;
          presence "true";
          leaf profile {
            type string;
          }
        }
        leaf vrf {
          type string;
        }
      }
