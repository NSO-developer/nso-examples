              enum "debug";
              enum "error";
              enum "info";
              enum "trace";
              enum "warning";
            }
          }
        }
      }
      container url {
        list profile {
          key "id";
          leaf id {
            type string;
          }
          leaf-list alert {
            tailf:cli-flat-list-syntax;
            type enumeration {
              enum "all";
              enum "blacklist";
              enum "categories-reputation";
              enum "whitelist";
            }
          }
          container blacklist {
            tailf:cli-add-mode;
            presence "true";
            container parameter-map {
              leaf regex {
                type string;
              }
            }
          }
          container categories {
            container allow {
              tailf:cli-add-mode;
              presence "true";
              list category {
                tailf:cli-drop-node-name;
                tailf:cli-suppress-mode;
                tailf:cli-delete-when-empty;
                key "name";
