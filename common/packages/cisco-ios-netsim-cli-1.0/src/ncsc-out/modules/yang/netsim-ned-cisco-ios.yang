  grouping ncs_rpc_notif_router-ospf-grouping {
    container capability {
      leaf vrf-lite {
        type empty;
      }
      leaf opaque {
        type boolean;
      }
      leaf lls {
        type boolean;
      }
      leaf transit {
        type boolean;
      }
