  grouping result-type-method-grouping {
    leaf authoritative {
      type empty;
    }
    leaf agent-not-found {
      type empty;
    }
    leaf none {
      type empty;
    }
    leaf success {
      type empty;
    }
    leaf method-timeout {
      type empty;
    }
