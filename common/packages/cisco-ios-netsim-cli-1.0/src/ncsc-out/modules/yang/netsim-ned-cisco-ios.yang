    container crypto {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      list keyring {
        key "name";
        leaf name {
          type string;
        }
        leaf vrf {
          tailf:cli-hide-in-submode;
          type string;
        }
        uses description-grouping;
        container local-address {
          uses interface-name-grouping;
        }
        container pre-shared-key {
          list address {
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            tailf:cli-compact-syntax;
            key "address";
            leaf ipv6 {
              tailf:cli-prefix-key;
              type empty;
            }
            leaf address {
              tailf:cli-suppress-range;
              type union {
                type inet:ipv4-address;
                type inet:ipv6-address;
                type ipv6-prefix;
              }
            }
            leaf mask {
              tailf:cli-drop-node-name;
              type inet:ipv4-address;
            }
            container key {
              tailf:cli-flatten-container;
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands;
              // NCS expand uses statement
              leaf encryption {
                tailf:cli-drop-node-name;
                tailf:cli-optional-in-sequence;
                type enumeration {
                  enum "0";
                  enum "6";
                  enum "7";
                }
              }
              leaf secret {
                tailf:cli-drop-node-name;
                type string;
              }
            }
          }
          list hostname {
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            tailf:cli-compact-syntax;
            key "name";
            leaf name {
              tailf:cli-suppress-range;
              type string;
            }
            container key {
              tailf:cli-flatten-container;
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands;
              // NCS expand uses statement
              leaf encryption {
                tailf:cli-drop-node-name;
                tailf:cli-optional-in-sequence;
                type enumeration {
                  enum "0";
                  enum "6";
                  enum "7";
                }
              }
              leaf secret {
                tailf:cli-drop-node-name;
                type string;
              }
            }
          }
        }
        container rsa-pubkey {
          list address {
            key "ip-address type";
            leaf ip-address {
              type inet:ipv4-address;
            }
            leaf type {
              type enumeration {
                enum "signature";
                enum "encryption";
              }
            }
            leaf address {
              type inet:ipv4-address;
            }
            container key-string {
              tailf:cli-add-mode;
              leaf hex-data {
                tailf:cli-drop-node-name;
                type string;
              }
            }
          }
        }
      }
      container key {
        container pubkey-chain {
          container rsa {
            tailf:cli-add-mode;
            list addressed-key {
              key "address";
              leaf address {
                type inet:ipv4-address;
              }
              container key-string {
                tailf:cli-add-mode;
                leaf hex-data {
                  tailf:cli-drop-node-name;
                  type string;
                }
              }
            }
          }
        }
      }
      container logging {
        leaf session {
          type empty;
        }
        leaf ikev2 {
          type empty;
        }
      }
      container ikev2 {
        list name-mangler {
          key "name";
          leaf name {
            type string;
          }
          container eap {
            choice eap-choice {
              leaf all {
                type empty;
              }
              container suffix {
                leaf delimiter {
                  type enumeration {
                    enum ".";
                    enum "@";
                  }
                }
              }
            }
          }
          leaf fqdn {
            type enumeration {
              enum "all";
              enum "domain";
              enum "hostname";
            }
          }
          leaf dn {
            type enumeration {
              enum "common-name";
              enum "country";
              enum "domain";
              enum "locality";
              enum "organization";
              enum "organization-unit";
              enum "state";
            }
          }
          leaf email {
            type enumeration {
              enum "all";
              enum "domain";
              enum "username";
            }
          }
        }
        container authorization {
          list policy {
            key "name";
            leaf name {
              type string;
            }
            leaf pool {
              type string;
            }
            leaf netmask {
              type inet:ipv4-address;
            }
            container aaa {
              container attribute {
                leaf list {
                  type string;
                }
              }
            }
            container ipv6 {
              leaf prefix {
                type uint8;
              }
              leaf pool {
                type string;
              }
              leaf dns {
                type inet:ipv6-address;
              }
            }
            container route {
              container set {
                container remote {
                  list ipv4 {
                    tailf:cli-suppress-mode;
                    tailf:cli-delete-when-empty;
                    key "prefix mask";
                    leaf prefix {
                      type inet:ipv4-address;
                    }
                    leaf mask {
                      type inet:ipv4-address;
                    }
                  }
                  list ipv6 {
                    tailf:cli-suppress-mode;
                    tailf:cli-delete-when-empty;
                    key "address";
                    leaf address {
                      type ipv6-prefix;
                    }
                  }
                }
                container access-list {
                  leaf ipv4 {
                    tailf:cli-drop-node-name;
                    type std-ip-acl-type;
                  }
                  leaf ipv6 {
                    type string;
                  }
                }
                container interface {
                  presence "true";
                }
                container interface-list {
                  tailf:cli-drop-node-name;
                  list interface {
                    tailf:cli-suppress-mode;
                    tailf:cli-delete-when-empty;
                    key "name";
                    leaf name {
                      type string;
                    }
                  }
                }
              }
              container accept {
                choice any-choice {
                  container any-enable {
                    tailf:cli-drop-node-name;
                    leaf any {
                      type boolean;
                    }
                  }
                  container any {
                    choice any-choice {
                      leaf distance {
                        type uint8;
                      }
                      leaf tag {
                        type uint32;
                      }
                    }
                  }
                }
              }
            }
            leaf session-lifetime {
              type uint32;
            }
            container dns {
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands {
                tailf:cli-reset-siblings;
              }
              leaf primary {
                tailf:cli-drop-node-name;
                type inet:ipv4-address;
              }
              leaf secondary {
                tailf:cli-drop-node-name;
                type inet:ipv4-address;
              }
            }
          }
        }
        container redirect {
          container client {
            tailf:cli-delete-when-empty;
            presence "true";
            leaf max-redirects {
              type uint8;
            }
          }
        }
        list keyring {
          key "name";
          leaf name {
            type string;
          }
          list peer {
            key "name";
            leaf name {
              type string;
            }
            leaf description {
              tailf:cli-multi-value;
              type string;
            }
            container address {
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands {
                tailf:cli-reset-siblings;
              }
              choice address-choice {
                case ipv4 {
                  leaf ipv4-address {
                    tailf:cli-drop-node-name;
                    type inet:ipv4-address;
                  }
                  leaf ipv4-mask {
                    tailf:cli-drop-node-name;
                    type inet:ipv4-address;
                  }
                }
                case ipv6 {
                  leaf ipv6-address {
                    tailf:cli-drop-node-name;
                    type ipv6-prefix;
                  }
                }
              }
            }
            container identity {
              choice identity-choice {
                leaf key-id {
                  type string;
                }
                container fqdn {
                  tailf:cli-compact-syntax;
                  tailf:cli-sequence-commands;
                  leaf domain {
                    tailf:cli-optional-in-sequence;
                    type empty;
                  }
                  leaf name {
                    tailf:cli-drop-node-name;
                    type string;
                  }
                }
                container email {
                  tailf:cli-compact-syntax;
                  tailf:cli-sequence-commands;
                  leaf domain {
                    tailf:cli-optional-in-sequence;
                    type empty;
                  }
                  leaf name {
                    tailf:cli-drop-node-name;
                    type string;
                  }
                }
                leaf address {
                  type union {
                    type inet:ipv4-address;
                    type inet:ipv6-address;
                  }
                }
              }
            }
            container pre-shared-key {
              tailf:cli-flatten-container;
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands;
              choice pre-shared-key-choice {
                case one-case {
                  // NCS expand uses statement
                  leaf encryption {
                    tailf:cli-drop-node-name;
                    tailf:cli-optional-in-sequence;
                    type enumeration {
                      enum "0";
                      enum "6";
                      enum "7";
                    }
                  }
                  leaf secret {
                    tailf:cli-drop-node-name;
                    type string;
                  }
                }
                case local-remote-case {
                  container local {
                    tailf:cli-optional-in-sequence;
                    tailf:cli-compact-syntax;
                    tailf:cli-sequence-commands;
                    // NCS expand uses statement
                    leaf encryption {
                      tailf:cli-drop-node-name;
                      tailf:cli-optional-in-sequence;
                      type enumeration {
                        enum "0";
                        enum "6";
                        enum "7";
                      }
                    }
                    leaf secret {
                      tailf:cli-drop-node-name;
                      type string;
                    }
                  }
                  container remote {
                    tailf:cli-compact-syntax;
                    tailf:cli-sequence-commands;
                    // NCS expand uses statement
                    leaf encryption {
                      tailf:cli-drop-node-name;
                      tailf:cli-optional-in-sequence;
                      type enumeration {
                        enum "0";
                        enum "6";
                        enum "7";
                      }
                    }
                    leaf secret {
                      tailf:cli-drop-node-name;
                      type string;
                    }
                  }
                }
              }
            }
          }
        }
        leaf proposal-default-disabled {
          type empty;
        }
        list proposal {
          key "name";
          leaf name {
            type string;
          }
          leaf-list encryption {
            tailf:cli-flat-list-syntax;
            ordered-by user;
            type enumeration {
              enum "aes-cbc-128";
              enum "3des";
              enum "aes-cbc-192";
