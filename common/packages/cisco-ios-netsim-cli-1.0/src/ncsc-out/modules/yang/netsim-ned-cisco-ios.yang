    list policy-map {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../ncs:module) or ../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      key "name";
      leaf name {
        type string;
      }
      leaf type {
        tailf:cli-prefix-key;
        type enumeration {
          enum "inspect";
          enum "performance-monitor";
          enum "mace";
          enum "packet-service";
          enum "appnav";
          enum "umbrella";
          enum "epbr";
        }
      }
      leaf protocol {
        tailf:cli-drop-node-name;
        tailf:cli-prefix-key;
        type enumeration {
          enum "http";
          enum "im";
          enum "imap";
          enum "p2p";
          enum "pop3";
          enum "smtp";
          enum "sunrpc";
          enum "avc";
        }
      }
      leaf description {
        tailf:cli-multi-value;
        type string;
      }
      container parameter {
        container default {
          leaf account-on-resolution {
            type empty;
          }
        }
      }
      list class {
        ordered-by user;
        key "name";
        leaf type {
          tailf:cli-prefix-key;
          type enumeration {
            enum "inspect";
          }
        }
        leaf name {
          type string;
        }
        // NCS expand uses statement
        leaf fragment {
          tailf:cli-hide-in-submode;
          type string;
        }
        leaf service-fragment {
          tailf:cli-hide-in-submode;
          type string;
        }
        container flow {
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
