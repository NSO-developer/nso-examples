  grouping ncs_rpc_notif_config-af-topology-grouping {
    container route-replicate {
      list from {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        key "name";
        leaf name {
          type enumeration {
            enum "unicast";
            enum "multicast";
          }
        }
        uses ncs_rpc_notif_config-af-topology-rr-grouping;
      }
    }
  }

  grouping ncs_rpc_notif_config-af-topology-rr-grouping {
    leaf all {
      type empty;
    }
  }

  grouping ncs_rpc_notif_ephone-dn-grouping {
    uses ncs_rpc_notif_description-grouping;
    container allow {
      leaf watch {
        type empty;
      }
    }
    container caller-id {
      leaf block {
        type empty;
      }
    }
    container call-forward {
      leaf all {
        type string;
      }
      container busy {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        leaf digits {
          tailf:cli-drop-node-name;
          type string;
        }
        leaf forward {
          tailf:cli-drop-node-name;
          type enumeration {
            enum "primary";
            enum "secondary";
          }
        }
        leaf dialplan-pattern {
          type empty;
        }
      }
      leaf night-service {
        type string;
      }
      container noan {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        leaf digits {
          tailf:cli-drop-node-name;
          type string;
        }
        leaf timeout {
          type uint16;
        }
      }
    }
    container corlist {
      leaf incoming {
        type string;
      }
      leaf outgoing {
        type string;
      }
    }
    container hold-alert {
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-all-siblings;
      }
      leaf timeout {
        tailf:cli-drop-node-name;
        type uint16;
      }
      leaf type {
        tailf:cli-drop-node-name;
        tailf:cli-break-sequence-commands;
        type enumeration {
          enum "idle";
          enum "originator";
          enum "shared";
          enum "shared-idle";
        }
      }
    }
    container translation-profile {
      leaf incoming {
        type string;
      }
      leaf outgoing {
        type string;
      }
    }
  }

  grouping ncs_rpc_notif_ephone-grouping {
    uses ncs_rpc_notif_description-grouping;
    container conference {
      container drop-mode {
        tailf:cli-delete-when-empty;
        presence "true";
        leaf creator {
          type empty;
        }
        leaf local {
          type empty;
        }
      }
      container add-mode {
        tailf:cli-delete-when-empty;
        presence "true";
        leaf creator {
          type empty;
        }
      }
      leaf admin {
        type empty;
      }
    }
    leaf max-calls-per-button {
      type uint8;
    }
    leaf busy-trigger-per-button {
      type uint8;
    }
    list fastdial {
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-siblings;
      }
      key "tag";
      leaf tag {
        type uint8;
      }
      leaf phone-number {
        tailf:cli-drop-node-name;
        type string;
      }
      leaf name {
        tailf:cli-multi-value;
        type string;
      }
    }
    list speed-dial {
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-siblings;
      }
      key "tag";
      leaf tag {
        type string;
      }
      leaf phone-number {
        tailf:cli-drop-node-name;
        type uint64;
      }
      leaf label {
        type string;
      }
    }
    container type {
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-all-siblings;
      }
      leaf ip-phone-module {
        tailf:cli-drop-node-name;
        tailf:cli-break-sequence-commands;
        type string;
      }
      container addon {
        tailf:cli-flatten-container;
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        leaf module-number-1 {
          tailf:alt-name "1";
          type string;
        }
        leaf module-number-2 {
          tailf:alt-name "2";
          type string;
        }
      }
    }
    container paging-dn {
      tailf:cli-delete-when-empty;
      presence "true";
      leaf ephone-dn-tag {
        tailf:cli-drop-node-name;
        type uint16;
      }
    }
    container night-service {
      leaf bell {
        type empty;
      }
    }
  }

  grouping ncs_rpc_notif_time-range-abs-grouping {
    leaf time {
      tailf:cli-drop-node-name;
      type ncs_rpc_notif_hhmm-type;
    }
    leaf date {
      tailf:cli-drop-node-name;
      type uint8;
    }
    leaf month {
      tailf:cli-drop-node-name;
      type ncs_rpc_notif_month-full-type;
    }
    leaf year {
      tailf:cli-drop-node-name;
      type uint16;
    }
  }

  grouping ncs_rpc_notif_privilege-level-grouping {
    list level {
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-compact-syntax;
      key "privilege";
      leaf privilege {
        tailf:cli-suppress-range;
        type uint8;
      }
      list command-list {
        tailf:cli-drop-node-name;
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-suppress-key-abbreviation;
        key "command";
        leaf command {
          tailf:cli-multi-word-key;
          tailf:cli-suppress-range;
          type string;
        }
      }
    }
  }

  grouping ncs_rpc_notif_srte-perf-meas-grouping {
    container performance-measurement {
      tailf:cli-add-mode;
      container delay-measurement {
        tailf:cli-add-mode;
        presence "true";
        leaf profile {
          type string;
        }
        container liveness-detection {
          tailf:cli-add-mode;
          presence "true";
          leaf invalidation-action {
            type enumeration {
              enum "down";
              enum "none";
            }
          }
        }
        container reverse-path {
          tailf:cli-add-mode;
          leaf label {
            type uint32;
          }
        }
      }
    }
  }

  grouping description-grouping {
    leaf description {
      tailf:cli-multi-value;
      type string;
    }
  }

  grouping description-quote-grouping {
    leaf description {
      type string;
    }
  }

  grouping password-grouping {
    leaf type {
      tailf:cli-drop-node-name;
      tailf:cli-optional-in-sequence;
