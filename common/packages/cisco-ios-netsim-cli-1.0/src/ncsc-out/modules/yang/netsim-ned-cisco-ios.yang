  grouping police-action-grouping {
    container actions {
      tailf:cli-break-sequence-commands;
      tailf:cli-no-keyword;
      tailf:cli-drop-node-name;
      tailf:cli-flatten-container;
      uses police-multiple-conform-action-grouping;
      uses police-multiple-exceed-action-grouping;
      uses police-multiple-violate-action-grouping;
    }
  }

  grouping policy-map-class-grouping {
    leaf fragment {
      tailf:cli-hide-in-submode;
      type string;
    }
    leaf service-fragment {
      tailf:cli-hide-in-submode;
      type string;
    }
    container flow {
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-siblings;
      }
      leaf monitor {
        type string;
      }
      leaf sampler {
        type string;
      }
    }
    container monitor {
      container metric {
        container rtp {
          tailf:cli-add-mode;
          list clock-rate {
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "id";
            leaf id {
              type uint8;
            }
            leaf rate {
              tailf:cli-drop-node-name;
              type uint32;
            }
          }
        }
      }
    }
    list react {
      key "id";
      leaf id {
        type uint16;
      }
      leaf type {
        tailf:cli-drop-node-name;
        tailf:cli-hide-in-submode;
        type enumeration {
          enum "media-stop";
          enum "mrv";
          enum "network-delay";
          enum "one-way-delay";
          enum "rtp-jitter-average";
          enum "rtp-jitter-inter-arrival-mean";
          enum "transport-bytes-lost-rate";
          enum "transport-packets-lost-rate";
        }
      }
      container threshold {
        container value {
          leaf ge {
            type string;
          }
        }
      }
      container action {
        leaf syslog {
          type empty;
        }
        leaf snmp {
          type empty;
        }
      }
    }
    leaf pass-through {
      type empty;
    }
    container policy {
      tailf:cli-drop-node-name;
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-siblings;
      }
      leaf action {
        tailf:cli-drop-node-name;
        type enumeration {
          enum "drop";
          enum "inspect";
          enum "pass";
          enum "allow";
          enum "deny";
        }
      }
      leaf log {
        tailf:cli-optional-in-sequence;
        type empty;
      }
      leaf parameter-map {
        tailf:cli-drop-node-name;
        type string;
      }
    }
    container inspect-police {
      tailf:cli-drop-node-name;
      container police {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        leaf rate {
          type uint32;
        }
        leaf burst {
          type uint32;
        }
      }
    }
    container bandwidth {
      leaf bits {
        tailf:cli-drop-node-name;
        type uint32;
      }
      leaf percent {
        type percentage-type;
      }
      container remaining {
        container percent {
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          leaf percent {
            tailf:cli-drop-node-name;
            type percentage-type;
          }
          uses bandwidth-remaining-account-grouping;
        }
        container ratio {
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          leaf ratio {
            tailf:cli-drop-node-name;
            type uint32;
          }
          uses bandwidth-remaining-account-grouping;
        }
      }
    }
    container compress {
      container header {
        container ip {
          tailf:cli-delete-when-empty;
          presence "true";
          leaf protocol {
            tailf:cli-drop-node-name;
            type enumeration {
              enum "rtp";
              enum "tcp";
            }
          }
        }
      }
    }
    leaf dbl {
      type empty;
    }
    container estimate {
      container bandwidth {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        presence "true";
        container delay-one-in {
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          leaf doi {
            tailf:cli-drop-node-name;
            type uint32;
          }
          leaf milliseconds {
            type uint32;
          }
        }
        leaf drop-one-in {
          type uint32;
        }
      }
    }
    leaf account {
      type empty;
    }
    container fair-queue {
      tailf:cli-delete-when-empty;
      presence "true";
      leaf dynamic-queues {
        tailf:cli-drop-node-name;
        type uint32;
      }
      leaf queue-limit {
        type uint32;
      }
