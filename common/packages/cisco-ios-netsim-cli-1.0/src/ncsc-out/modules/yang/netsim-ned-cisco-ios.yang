        uses ncs_rpc_notif_router-ospf-route-map-grouping;
      }
      container static {
        tailf:cli-compact-syntax;
        presence "true";
        uses ncs_rpc_notif_router-ospf-redistribute-grouping;
        uses ncs_rpc_notif_router-ospf-route-map-grouping;
      }
      container odr {
        tailf:cli-compact-syntax;
