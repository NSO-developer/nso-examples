  grouping ncs_rpc_notif_ip-msdp-grouping {
    list peer {
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-compact-syntax;
      key "address";
      leaf address {
        type inet:host;
      }
      container connect-source {
        tailf:cli-flatten-container;
        tailf:cli-compact-syntax;
        uses ncs_rpc_notif_interface-name-grouping;
      }
      leaf remote-as {
        type uint16;
      }
    }
    list description {
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      key "address";
      leaf address {
        type inet:host;
      }
      leaf text {
        tailf:cli-drop-node-name;
        tailf:cli-multi-value;
        type string;
      }
    }
    list keepalive {
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-compact-syntax;
      key "address";
      leaf address {
        type inet:host;
      }
      leaf keepalive-interval {
        tailf:cli-drop-node-name;
        type uint8;
      }
      leaf hold-time-interval {
        tailf:cli-drop-node-name;
        type uint8;
      }
    }
    list sa-filter {
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-compact-syntax;
      key "direction address";
      leaf direction {
        type enumeration {
          enum "in";
          enum "out";
        }
      }
      leaf address {
        type inet:host;
      }
      choice list-choice {
        leaf list {
          type ncs_rpc_notif_ext-acl-type;
        }
        leaf route-map {
          type string;
        }
        leaf rp-list {
          type union {
            type uint16;
            type string;
          }
        }
        leaf rp-route-map {
          type string;
        }
      }
    }
    list sa-limit {
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      key "address";
      leaf address {
        type inet:host;
      }
      leaf value {
        tailf:cli-drop-node-name;
        type uint32;
      }
    }
    container password {
      list peer {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "address";
        leaf address {
          type inet:host;
        }
        container password {
          tailf:cli-drop-node-name;
          tailf:cli-flatten-container;
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          // NCS expand uses statement
          leaf type {
            tailf:cli-drop-node-name;
            tailf:cli-optional-in-sequence;
            type enumeration {
              enum "0";
              enum "5";
              enum "6";
              enum "7";
            }
          }
          leaf secret {
            tailf:cli-drop-node-name;
            type string;
          }
        }
      }
    }
    container rpf {
