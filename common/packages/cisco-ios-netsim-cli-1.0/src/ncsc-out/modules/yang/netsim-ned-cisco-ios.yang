    container map-class {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      list frame-relay {
        key "name";
        leaf name {
          type string;
        }
        container frame-relay {
          leaf cir {
            type uint32;
          }
          leaf mincir {
            type uint32;
          }
          leaf fragment {
            type uint16;
          }
          container bc {
            leaf value {
              tailf:cli-drop-node-name;
              type uint32;
            }
          }
          container be {
            leaf value {
              tailf:cli-drop-node-name;
              type uint32;
            }
          }
          container fair-queue {
            presence "true";
          }
        }
        container service-policy {
          uses service-policy-grouping;
        }
      }
    }
    container class {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      list cem {
        key "name";
        leaf name {
          type string;
        }
        leaf payload-size {
          type uint16;
        }
        leaf dejitter-buffer {
          type uint16;
        }
        leaf idle-pattern {
          type string;
        }
