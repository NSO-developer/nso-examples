              enum "ctag-vlan-id";
              enum "hostname";
              enum "nas-port";
              enum "payload-etype";
              enum "peer-ip-address";
              enum "remote-id";
              enum "stag-cos";
              enum "stag-type";
              enum "stag-vlan-id";
              enum "vc-id";
              enum "vendor-class-id";
            }
          }
        }
      }
      container authenticate {
