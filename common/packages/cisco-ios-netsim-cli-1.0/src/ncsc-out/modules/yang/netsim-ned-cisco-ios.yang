            }
            leaf adjustment-threshold {
              type uint8;
            }
            leaf max-bw {
              type uint32;
            }
            leaf min-bw {
              type uint32;
            }
            leaf collect-bw {
              type empty;
            }
          }
          leaf record-route {
            type empty;
          }
          container fast-reroute {
