  grouping ncs_rpc_notif_interface-encryption-mode-grouping {
    container mode {
      container ciphers {
        tailf:cli-flatten-container;
        tailf:cli-compact-syntax;
        choice suite-choice {
          leaf ckip {
            type empty;
          }
          leaf ckip-cmic {
            type empty;
          }
          leaf cmic {
            type empty;
          }
          case a {
            leaf aes-ccm {
              type empty;
            }
            leaf tkip {
              type empty;
            }
            leaf wep {
              tailf:cli-drop-node-name;
              type enumeration {
                enum "wep128";
                enum "wep40";
              }
            }
          }
        }
      }
    }
  }

  grouping ncs_rpc_notif_ip-ssh-algorithm-grouping {
    container algorithm {
      leaf-list mac {
        tailf:cli-flat-list-syntax;
        ordered-by user;
        type enumeration {
          enum "hmac-sha1";
          enum "hmac-sha1-96";
          enum "hmac-sha2-256";
          enum "hmac-sha2-512";
          enum "hmac-sha2-256-etm@openssh.com";
          enum "hmac-sha2-512-etm@openssh.com";
        }
      }
      leaf-list encryption {
        tailf:cli-flat-list-syntax;
        ordered-by user;
        type enumeration {
          enum "3des-cbc";
          enum "aes128-cbc";
          enum "aes128-ctr";
          enum "aes192-cbc";
          enum "aes192-ctr";
          enum "aes256-cbc";
          enum "aes256-ctr";
          enum "aes256-gcm";
          enum "aes128-gcm";
        }
      }
      leaf-list hostkey {
        tailf:cli-flat-list-syntax;
        ordered-by user;
        type enumeration {
          enum "ssh-rsa";
          enum "rsa-sha2-256";
          enum "rsa-sha2-512";
          enum "x509v3-ssh-rsa";
        }
      }
      leaf-list authentication {
        tailf:cli-flat-list-syntax;
        ordered-by user;
        type enumeration {
          enum "password";
          enum "keyboard";
          enum "publickey";
        }
      }
      leaf-list kex {
        tailf:cli-flat-list-syntax;
        ordered-by user;
        type enumeration {
          enum "diffie-hellman-group14-sha1";
          enum "diffie-hellman-group-exchange-sha1";
          enum "ecdh-sha2-nistp256";
          enum "ecdh-sha2-nistp384";
          enum "ecdh-sha2-nistp521";
        }
      }
      leaf-list publickey {
        tailf:cli-flat-list-syntax;
        ordered-by user;
        type enumeration {
          enum "ecdsa-sha2-nistp256";
          enum "ecdsa-sha2-nistp384";
          enum "ecdsa-sha2-nistp521";
          enum "rsa-sha2-256";
          enum "rsa-sha2-512";
          enum "ssh-rsa";
          enum "x509v3-ecdsa-sha2-nistp256";
          enum "x509v3-ecdsa-sha2-nistp384";
          enum "x509v3-ecdsa-sha2-nistp521";
          enum "x509v3-ssh-rsa";
          enum "x509v3-rsa2048-sha256";
          enum "ssh-ed25519";
        }
      }
    }
