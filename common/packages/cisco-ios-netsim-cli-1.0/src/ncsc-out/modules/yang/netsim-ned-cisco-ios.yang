    container max-metric {
      container router-lsa {
        tailf:cli-compact-syntax;
        presence "true";
        leaf include-stub {
          type empty;
        }
        leaf stub-prefix-lsa {
          type empty;
        }
        leaf summary-lsa {
          type empty;
        }
        leaf summary-lsa-max-metric-value {
          tailf:cli-drop-node-name;
          type uint32;
        }
        leaf inter-area-lsas {
          type empty;
        }
        leaf external-lsa {
          type empty;
        }
