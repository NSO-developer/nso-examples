  grouping ncs_template_police-action-grouping {
    container actions {
      tailf:cli-drop-node-name;
      uses ncs_template_police-multiple-conform-action-grouping;
      uses ncs_template_police-multiple-exceed-action-grouping;
      uses ncs_template_police-multiple-violate-action-grouping;
    }
  }

  grouping ncs_template_policy-map-class-grouping {
    leaf fragment {
      type string;
    }
    leaf service-fragment {
      type string;
    }
    container flow {
      leaf monitor {
        type string;
      }
      leaf sampler {
        type string;
      }
    }
    container monitor {
      container metric {
        container rtp {
          list clock-rate {
            // NCS patched for predictable order
            ordered-by user;
            tailf:cli-suppress-mode;
            key "id";
            leaf id {
              type string;
            }
            leaf rate {
              tailf:cli-drop-node-name;
              type string;
            }
          }
        }
      }
    }
    list react {
      // NCS patched for predictable order
      ordered-by user;
      key "id";
      leaf id {
        type string;
      }
      leaf type {
        tailf:cli-drop-node-name;
        type string;
      }
      container threshold {
        container value {
          leaf ge {
            type string;
          }
        }
      }
      container action {
        leaf syslog {
          type empty;
        }
        leaf snmp {
          type empty;
        }
      }
    }
    leaf pass-through {
      type empty;
    }
    container policy {
      tailf:cli-drop-node-name;
      leaf action {
        tailf:cli-drop-node-name;
        type string;
      }
      leaf log {
        type empty;
      }
      leaf parameter-map {
        tailf:cli-drop-node-name;
        type string;
      }
    }
    container inspect-police {
      tailf:cli-drop-node-name;
      container police {
        leaf rate {
          type string;
        }
        leaf burst {
          type string;
        }
      }
    }
    container bandwidth {
      leaf bits {
        tailf:cli-drop-node-name;
        type string;
      }
      leaf percent {
        type ncs_template_percentage-type;
      }
      container remaining {
        container percent {
          leaf percent {
            tailf:cli-drop-node-name;
            type ncs_template_percentage-type;
          }
          uses ncs_template_bandwidth-remaining-account-grouping;
        }
        container ratio {
          leaf ratio {
            tailf:cli-drop-node-name;
            type string;
          }
          uses ncs_template_bandwidth-remaining-account-grouping;
        }
      }
    }
    container compress {
      container header {
        container ip {
          presence "true";
          leaf protocol {
            tailf:cli-drop-node-name;
            type string;
          }
        }
      }
    }
    leaf dbl {
      type empty;
    }
    container estimate {
      container bandwidth {
        presence "true";
        container delay-one-in {
          leaf doi {
            tailf:cli-drop-node-name;
            type string;
          }
          leaf milliseconds {
            type string;
          }
        }
        leaf drop-one-in {
          type string;
        }
      }
    }
    leaf account {
      type empty;
    }
    container fair-queue {
      presence "true";
      leaf dynamic-queues {
        tailf:cli-drop-node-name;
        type string;
      }
      leaf queue-limit {
        type string;
      }
    }
    leaf netflow-sampler {
      type string;
    }
    container police-aggregate {
      tailf:cli-drop-node-name;
      container police {
        leaf aggregate {
          type string;
        }
      }
    }
    choice police-choice {
      case police-cirmode-case {
        container police-policy-map {
          tailf:cli-drop-node-name;
          container police {
            leaf cir {
              type ncs_template_police-bps-type;
            }
            leaf bc {
              type ncs_template_police-burst-type;
            }
            leaf be {
              type ncs_template_police-burst-type;
            }
            leaf pir {
              type ncs_template_police-bps-type;
            }
            container pir-be {
              tailf:cli-drop-node-name;
              leaf be {
                type ncs_template_police-burst-type;
              }
            }
            container account {
              leaf user-defined {
                type string;
              }
            }
            uses ncs_template_police-action-grouping;
            container conform-color {
              leaf class-map-name {
                tailf:cli-drop-node-name;
                type string;
              }
              leaf exceed-color {
                type string;
              }
            }
          }
        }
      }
      case police-cir-percent-case {
        container police-cir-percent {
