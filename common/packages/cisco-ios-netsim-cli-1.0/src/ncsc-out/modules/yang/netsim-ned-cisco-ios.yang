      container spf {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        leaf spf-start {
          tailf:cli-drop-node-name;
          type uint32;
        }
        leaf spf-hold {
          tailf:cli-drop-node-name;
          type uint32;
        }
      }
      container throttle {
        container lsa {
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          leaf all {
            tailf:cli-optional-in-sequence;
            type empty;
          }
          leaf start-interval {
            tailf:cli-drop-node-name;
            type uint32;
          }
          leaf hold-interval {
            tailf:cli-drop-node-name;
            type uint32;
          }
          leaf max-interval {
            tailf:cli-drop-node-name;
            type uint32;
          }
        }
        container spf {
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          leaf spf-start {
            tailf:cli-drop-node-name;
            type uint32;
          }
          leaf spf-hold {
            tailf:cli-drop-node-name;
            type uint32;
          }
          leaf spf-max-wait {
            tailf:cli-drop-node-name;
            type uint32;
          }
        }
      }
    }
    leaf priority {
      type uint8;
    }
    leaf router-id {
      type inet:ipv4-address;
    }
