      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      list Null {
        tailf:cli-allow-join-with-key;
        tailf:cli-suppress-key-abbreviation;
        key "name";
