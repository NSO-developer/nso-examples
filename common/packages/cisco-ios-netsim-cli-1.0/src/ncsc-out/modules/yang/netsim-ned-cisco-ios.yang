                leaf one {
                  tailf:alt-name "1";
                  tailf:cli-optional-in-sequence;
                  type empty;
                }
                leaf two {
                  tailf:alt-name "2";
                  tailf:cli-optional-in-sequence;
                  type empty;
                }
                leaf three {
                  tailf:alt-name "3";
                  tailf:cli-optional-in-sequence;
                  type empty;
                }
                leaf four {
