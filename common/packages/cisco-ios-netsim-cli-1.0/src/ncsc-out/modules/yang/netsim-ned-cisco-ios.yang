                leaf authorize {
                  type empty;
                }
              }
              container authorize {
                leaf-list vlan {
                  type uint16;
                }
                leaf voice {
                  type empty;
                }
              }
            }
          }
          container alive {
            container action {
              leaf reinitialize {
                type empty;
              }
            }
          }
        }
        container no-response {
