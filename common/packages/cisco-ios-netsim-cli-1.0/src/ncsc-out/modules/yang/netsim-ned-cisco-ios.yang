      list track-object {
        tailf:cli-drop-node-name;
        tailf:cli-compact-syntax;
        key "object-number";
        leaf object-number {
          type uint16;
        }
        choice track-type {
          container rtr {
            tailf:cli-hide-in-submode;
            tailf:cli-flatten-container;
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands;
            leaf operation-number {
              tailf:cli-drop-node-name;
              type uint32;
            }
            leaf option {
              tailf:cli-drop-node-name;
              type enumeration {
                enum "reachability";
                enum "state";
              }
            }
          }
          container list {
            tailf:cli-hide-in-submode;
            tailf:cli-flatten-container;
            tailf:cli-compact-syntax;
            leaf boolean {
              type enumeration {
                enum "and";
                enum "or";
              }
            }
          }
          container list-threshold {
            tailf:cli-drop-node-name;
            tailf:cli-flatten-container;
            tailf:cli-hide-in-submode;
            container list {
              leaf threshold {
                type enumeration {
                  enum "percentage";
                  enum "weight";
                }
              }
            }
          }
          container interface {
            tailf:cli-hide-in-submode;
            tailf:cli-flatten-container;
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands;
            uses interface-name-grouping;
            container ip {
              tailf:cli-flatten-container;
              tailf:cli-optional-in-sequence;
              leaf routing {
                type empty;
              }
            }
            container ipv6 {
              tailf:cli-flatten-container;
              tailf:cli-optional-in-sequence;
              leaf routing {
                type empty;
              }
            }
            leaf line-protocol {
              type empty;
            }
          }
          container ip {
            tailf:cli-hide-in-submode;
            tailf:cli-flatten-container;
            tailf:cli-compact-syntax;
            container route {
              tailf:cli-flatten-container;
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands;
              leaf prefix {
                tailf:cli-drop-node-name;
                type inet:ipv4-address;
              }
              leaf mask {
                tailf:cli-drop-node-name;
                type inet:ipv4-address;
              }
              choice option-choice {
                leaf reachability {
                  type empty;
                }
                container metric {
                  tailf:cli-flatten-container;
                  leaf threshold {
                    type empty;
                  }
                }
              }
            }
            container sla {
              tailf:cli-flatten-container;
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands;
              leaf operation-number {
                tailf:cli-drop-node-name;
                type uint32;
              }
              choice option-choice {
                leaf reachability {
                  type empty;
                }
                leaf state {
                  type empty;
                }
              }
            }
          }
          container ipv6 {
            tailf:cli-hide-in-submode;
            tailf:cli-flatten-container;
            tailf:cli-compact-syntax;
            container route {
              tailf:cli-flatten-container;
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands;
              leaf prefix {
                tailf:cli-drop-node-name;
                type ipv6-prefix;
              }
              choice option-choice {
                leaf reachability {
                  type empty;
                }
                container metric {
                  tailf:cli-flatten-container;
                  leaf threshold {
                    type empty;
                  }
                }
              }
            }
          }
          leaf stub-object {
            tailf:cli-hide-in-submode;
            type empty;
          }
        }
        list object {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "id";
          leaf id {
            type uint16;
          }
          choice object-choice {
            leaf not {
              type empty;
            }
            leaf weight {
              type uint8;
            }
          }
        }
        container ip-vrf {
          tailf:cli-drop-node-name;
          container ip {
            leaf vrf {
              type string;
            }
          }
        }
        container ipv6-vrf {
          tailf:cli-drop-node-name;
          container ipv6 {
            leaf vrf {
              type string;
            }
          }
        }
        container threshold {
          container percentage {
            leaf down {
              type uint8;
            }
            leaf up {
              type uint8;
            }
          }
          container metric {
            tailf:cli-compact-syntax;
            leaf up {
              type uint8;
            }
            leaf down {
              type uint8;
            }
          }
          container weight {
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            leaf down {
              tailf:cli-optional-in-sequence;
              type uint8;
            }
            leaf up {
              type uint8;
            }
          }
        }
        leaf carrier-delay {
          type empty;
        }
        container delay {
          tailf:cli-compact-syntax;
          leaf down {
            type uint8;
          }
          leaf up {
            type uint8;
          }
        }
        leaf default-state {
          type enumeration {
            enum "down";
            enum "up";
          }
        }
