            enum "ConfList";
            enum "Confrn";
            enum "Endcall";
            enum "Flash";
            enum "HLog";
            enum "Hold";
            enum "Join";
            enum "LiveRcd";
            enum "Mobility";
            enum "Park";
            enum "RmLstC";
            enum "Select";
            enum "TrnsfVM";
            enum "Trnsfer";
          }
        }
        leaf-list ringing {
          tailf:cli-flat-list-syntax;
          ordered-by user;
          type enumeration {
            enum "Answer";
            enum "Dnd";
            enum "HLog";
          }
