          list secondary-list {
            tailf:cli-drop-node-name;
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "address";
            leaf address {
              type union {
                type inet:ipv4-address;
                type ios:ncs_rpc_notif_ipv6-prefix;
              }
            }
            leaf secondary {
              type empty;
            }
          }
        }
      }
    }
    container vrrs {
      list pathway {
        key "name";
