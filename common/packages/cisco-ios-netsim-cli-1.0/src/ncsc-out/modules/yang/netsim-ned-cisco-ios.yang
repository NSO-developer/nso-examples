  grouping interface-ethernet-post-grouping {
    container fhrp {
      container delay {
        leaf minimum {
          type uint16;
        }
        leaf reload {
          type uint16;
        }
      }
    }
    container vrrp-conf {
      tailf:cli-drop-node-name;
      container vrrp {
        container delay {
          tailf:cli-compact-syntax;
          leaf minimum {
            type uint16;
          }
          leaf reload {
            type uint16;
          }
        }
      }
    }
    list vrrp {
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      key "id";
      leaf id {
        type uint8;
      }
      container authentication {
        choice auth {
          leaf word {
            tailf:cli-drop-node-name;
            type string;
          }
          container md5 {
            leaf key-chain {
              type string;
            }
            container key-string {
              tailf:cli-flatten-container;
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands;
              // NCS expand uses statement
              leaf type {
                tailf:cli-drop-node-name;
                tailf:cli-optional-in-sequence;
                type enumeration {
                  enum "0";
                  enum "5";
                  enum "6";
                  enum "7";
                }
              }
              leaf secret {
                tailf:cli-drop-node-name;
                type string;
              }
              leaf timeout {
                type uint16;
              }
            }
          }
          leaf text {
            type string;
          }
        }
      }
      uses interface-vrrp-grouping;
      container ip {
        leaf address {
          tailf:cli-drop-node-name;
          type inet:ipv4-address;
        }
        list secondary-address {
          tailf:cli-drop-node-name;
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "address";
          leaf address {
            type inet:ipv4-address;
          }
          leaf secondary {
            type empty;
          }
        }
      }
    }
    container vrrv3p-v3 {
      tailf:cli-drop-node-name;
      list vrrp {
        key "id address-family";
        leaf id {
          type uint8;
        }
        leaf address-family {
          type enumeration {
            enum "ipv4";
            enum "ipv6";
          }
        }
        uses interface-vrrp-grouping;
        container address {
          list primary-list {
            tailf:cli-drop-node-name;
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "address";
            leaf address {
              type union {
                type inet:ipv4-address;
                type inet:ipv6-address;
              }
            }
            leaf primary {
              type empty;
            }
          }
          list secondary-list {
            tailf:cli-drop-node-name;
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "address";
            leaf address {
              type union {
                type inet:ipv4-address;
                type ios:ipv6-prefix;
              }
            }
            leaf secondary {
              type empty;
            }
          }
        }
      }
    }
    container vrrs {
      list pathway {
        key "name";
        leaf name {
          type string;
        }
        uses description-grouping;
        list address {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "address";
          leaf address {
            type union {
              type inet:ipv4-address;
              type inet:ipv6-address;
              type ios:ipv6-prefix;
            }
          }
        }
      }
    }
  }

