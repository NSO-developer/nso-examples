              leaf peer {
                type string;
              }
            }
            leaf route-table {
              type string;
            }
            container cidr {
              leaf ip {
                type ios:ipv4-prefix;
              }
            }
            leaf eni {
              type string;
            }
            leaf region {
              type string;
            }
          }
        }
      }
