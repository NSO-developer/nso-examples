          }
          list application {
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "services-value";
            leaf services-value {
              type string;
            }
            leaf policy {
              type enumeration {
                enum "best-effort";
                enum "bulk-data";
                enum "custom";
                enum "low-latency-data";
                enum "real-time-video";
                enum "scavenger";
                enum "voice";
              }
            }
          }
        }
        uses domain-path-preference-grouping;
        leaf path-last-resort {
          type string;
        }
      }
    }
  }

  grouping domain-border-grouping {
    container border {
      tailf:cli-add-mode;
      presence "true";
      leaf master {
        type union {
          type inet:ipv4-address;
          type enumeration {
            enum "local";
          }
        }
      }
      container source-interface {
        uses interface-name-grouping;
      }
      container password {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        // NCS expand uses statement
        leaf type {
          tailf:cli-drop-node-name;
          tailf:cli-optional-in-sequence;
          type enumeration {
            enum "0";
            enum "5";
            enum "6";
            enum "7";
          }
        }
        leaf secret {
          tailf:cli-drop-node-name;
          type string;
        }
      }
    }
  }

  grouping carrier-delay-grouping {
    choice delay-choice {
      leaf seconds {
        tailf:cli-drop-node-name;
        type uint8;
      }
      leaf msec {
        type uint16;
      }
    }
  }

  grouping crypto-pki-server-lifetime-grouping {
    leaf days {
      tailf:cli-drop-node-name;
      type uint16;
    }
    leaf hours {
      tailf:cli-drop-node-name;
      type uint16;
    }
    leaf minutes {
      tailf:cli-drop-node-name;
      type uint16;
    }
  }

  grouping crypto-gdoi-local-server-grouping {
    leaf split-resilency {
      type boolean;
    }
    leaf gdoi {
      type boolean;
    }
    leaf gikev2 {
      type string;
    }
    container rekey {
      container lifetime {
        choice lifetime-choice {
          leaf seconds {
            type uint32;
          }
          leaf days {
            type uint32;
          }
        }
      }
      container algorithm {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        leaf encryption {
          tailf:cli-drop-node-name;
          type enumeration {
            enum "3des-cbc";
            enum "des-cbc";
            enum "aes";
          }
        }
        leaf bits {
          tailf:cli-drop-node-name;
          type enumeration {
            enum "128";
            enum "192";
            enum "256";
          }
        }
      }
      container sig-hash {
        leaf algorithm {
          type enumeration {
            enum "sha";
            enum "sha256";
            enum "sha384";
            enum "sha512";
          }
        }
      }
      container retransmit {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        leaf number-of-seconds {
          tailf:cli-drop-node-name;
          type uint8;
        }
        choice retransmit-choice {
          leaf number {
            type uint8;
          }
          leaf periodic {
            type empty;
          }
        }
      }
      container authentication {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        choice authentication-choice {
          leaf mypubkey {
            type empty;
          }
          leaf pubkey {
            type empty;
          }
        }
        leaf rsa {
          type string;
        }
      }
      container transport {
        leaf unicast {
          type empty;
        }
      }
    }
    container identifier {
      tailf:cli-add-mode;
      container range {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        leaf lowest {
          tailf:cli-drop-node-name;
          type uint8;
        }
        leaf hyphen {
          tailf:alt-name "-";
          type empty;
        }
        leaf highest {
          tailf:cli-drop-node-name;
          type uint8;
        }
      }
    }
    container authorization {
      container address {
        leaf ipv4 {
          type union {
            type uint8;
            type string;
          }
        }
      }
      leaf identity {
        type string;
      }
    }
    container replay {
      container time {
        leaf window-size {
          type uint32;
        }
      }
    }
    container sa {
      leaf receive-only {
        type empty;
      }
      container d3p {
        container window {
          choice window-choice {
            leaf msec {
              type uint32;
            }
            leaf sec {
              type uint8;
            }
          }
        }
      }
      list ipsec {
        key "id";
        leaf id {
          type uint32;
        }
        leaf profile {
          type string;
        }
        container match {
          container address {
            choice address-choice {
              leaf ipv4 {
                type ext-ip-acl-type;
              }
              leaf ipv6 {
                type string;
              }
            }
          }
        }
        container replay {
          choice replay-choice {
            container time {
              leaf window-size {
                type uint8;
              }
            }
            container counter {
              leaf window-size {
                type ipsec-window-size-type;
              }
            }
          }
        }
        choice tag-choice {
          container tag {
            container cts {
              leaf sgt {
                type empty;
              }
            }
          }
          container tag-enable {
            tailf:cli-drop-node-name;
            leaf tag {
              type boolean;
            }
          }
        }
      }
    }
    container address {
      leaf ipv4 {
        type union {
          type inet:ipv4-address;
          type string;
        }
      }
    }
    container redundancy {
      tailf:cli-add-mode;
      container local {
        tailf:cli-delete-when-empty;
        presence "true";
        leaf priority {
          type uint8;
        }
      }
      container peer {
        container address {
          leaf-list ipv4 {
            ordered-by user;
            type inet:ipv4-address;
          }
        }
      }
      container protocol {
        leaf version {
          type enumeration {
            enum "base";
            enum "optimize";
          }
        }
      }
    }
    leaf pfs {
      type boolean;
    }
  }

  grouping crypto-pki-certificate-grouping {
