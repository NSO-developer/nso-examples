            type empty;
          }
        }
      }
      leaf maxas-limit {
        type uint16;
      }
      container default {
        leaf ipv4-unicast {
          type boolean;
        }
        leaf ipv4-activate {
          type boolean;
        }
        leaf ipv6-nexthop {
          type boolean;
        }
        leaf local-preference {
          type uint32;
        }
        container route-target {
          leaf filter {
            type boolean;
          }
        }
      }
      leaf mpls-local-label {
        type empty;
      }
      container rpki {
        container server {
          list tcp {
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "address port";
            leaf address {
              type union {
                type inet:ipv4-address;
                type inet:ipv6-address;
              }
            }
            leaf port {
              type uint16;
            }
            leaf refresh {
              type uint16;
            }
          }
        }
      }
    }
    container timers {
      container bgp {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        leaf keepalive {
          tailf:cli-drop-node-name;
          type uint16;
        }
        leaf holdtime {
          tailf:cli-drop-node-name;
          type uint16;
        }
        leaf min-holdtime {
          tailf:cli-drop-node-name;
          type uint16;
        }
      }
    }
  }

  grouping ncs_rpc_notif_router-ospf-af-grouping;

