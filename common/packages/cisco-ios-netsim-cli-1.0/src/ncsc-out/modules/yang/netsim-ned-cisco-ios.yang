              list list {
                tailf:cli-drop-node-name;
                tailf:cli-suppress-mode;
                tailf:cli-delete-when-empty;
                key "name";
                leaf name {
                  type string;
                }
                list attributes {
                  tailf:cli-drop-node-name;
                  tailf:cli-suppress-mode;
                  tailf:cli-delete-when-empty;
                  ordered-by user;
                  key "line";
                  leaf line {
                    type string;
                  }
                }
              }
            }
          }
        }
      }
      container server {
        container radius {
          container dynamic-author {
            tailf:cli-add-mode;
            list client {
              tailf:cli-suppress-mode;
              tailf:cli-delete-when-empty;
              ordered-by user;
              key "address";
              leaf address {
                type inet:host;
              }
              container server-key {
                tailf:cli-flatten-container;
                tailf:cli-compact-syntax;
                tailf:cli-sequence-commands;
                // NCS expand uses statement
                leaf type {
                  tailf:cli-drop-node-name;
                  tailf:cli-optional-in-sequence;
                  type enumeration {
                    enum "0";
                    enum "5";
                    enum "6";
                    enum "7";
                  }
                }
                leaf secret {
                  tailf:cli-drop-node-name;
                  type string;
                }
              }
            }
            container client-vrf {
              tailf:cli-drop-node-name;
              list client {
                tailf:cli-suppress-mode;
                tailf:cli-delete-when-empty;
                ordered-by user;
                key "address vrf";
                leaf address {
                  type inet:host;
                }
                leaf vrf {
                  type string;
                }
                container server-key {
                  tailf:cli-flatten-container;
                  tailf:cli-compact-syntax;
                  tailf:cli-sequence-commands;
                  // NCS expand uses statement
                  leaf type {
                    tailf:cli-drop-node-name;
                    tailf:cli-optional-in-sequence;
                    type enumeration {
                      enum "0";
                      enum "5";
                      enum "6";
                      enum "7";
                    }
                  }
                  leaf secret {
                    tailf:cli-drop-node-name;
                    type string;
                  }
                }
              }
            }
            leaf port {
              type uint16;
            }
            leaf auth-type {
              type enumeration {
                enum "all";
                enum "any";
                enum "session-key";
              }
            }
            container server-key {
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands;
              // NCS expand uses statement
              leaf type {
                tailf:cli-drop-node-name;
                tailf:cli-optional-in-sequence;
                type enumeration {
                  enum "0";
                  enum "5";
                  enum "6";
                  enum "7";
                }
              }
              leaf secret {
                tailf:cli-drop-node-name;
                type string;
              }
            }
            container ignore {
              leaf session-key {
                type empty;
              }
              leaf server-key {
                type empty;
              }
              leaf retransmission {
                type empty;
              }
            }
          }
        }
      }
