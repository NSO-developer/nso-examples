                  tailf:cli-suppress-range;
                  type utd-category-type;
                }
              }
            }
            container block {
              tailf:cli-add-mode;
              presence "true";
              list category {
                tailf:cli-drop-node-name;
                tailf:cli-suppress-mode;
                tailf:cli-delete-when-empty;
                key "name";
                leaf name {
                  tailf:cli-suppress-range;
                  type utd-category-type;
                }
              }
            }
          }
          container block {
            leaf local-server {
              type string;
            }
            leaf page-profile {
              type string;
            }
          }
          container log {
            leaf level {
              type enumeration {
                enum "detailed";
                enum "error";
                enum "info";
              }
            }
          }
          container reputation {
            tailf:cli-add-mode;
            presence "true";
