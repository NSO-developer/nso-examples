  grouping ncs_rpc_notif_interface-ethernet-switch-grouping {
    // NCS expand uses statement
    container authentication {
      leaf control-direction {
        type enumeration {
          enum "both";
          enum "in";
        }
      }
      container event {
        container fail {
          tailf:cli-compact-syntax;
          leaf retry {
            type uint8;
          }
          container action {
            tailf:cli-flatten-container;
            choice authentication-event-fail-action-choice {
              container authorize {
                tailf:cli-flatten-container;
                tailf:cli-compact-syntax;
                leaf vlan {
                  type uint16;
                }
              }
              leaf next-method {
                type empty;
              }
            }
          }
        }
        container server {
          container dead {
