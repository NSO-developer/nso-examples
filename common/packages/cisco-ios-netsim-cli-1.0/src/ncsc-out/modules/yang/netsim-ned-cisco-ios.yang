            container drop {
              presence "true";
            }
            container forward {
              tailf:cli-delete-when-empty;
              presence "true";
              leaf capture {
                type empty;
              }
            }
          }
        }
        container match {
          container mac {
            leaf-list address {
              tailf:cli-flat-list-syntax;
              type string;
            }
          }
          container ip {
            leaf-list address {
              tailf:cli-flat-list-syntax;
