          tailf:cli-drop-node-name;
          type uint32;
        }
        container on-startup {
          tailf:cli-flatten-container;
          tailf:cli-compact-syntax;
          choice time-wait-for-bgp-choice {
            leaf seconds {
              tailf:cli-drop-node-name;
              type uint32;
