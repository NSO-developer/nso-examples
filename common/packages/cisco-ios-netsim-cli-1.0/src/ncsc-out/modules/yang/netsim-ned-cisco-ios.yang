          tailf:cli-optional-in-sequence;
          type empty;
        }
        container local-address {
          tailf:cli-optional-in-sequence;
          uses interface-name-grouping;
        }
        container gdoi {
          tailf:cli-optional-in-sequence;
          container fail-close {
            tailf:cli-add-mode;
            presence "true";
            container match {
              leaf address {
                type ext-acl-type;
              }
            }
            leaf activate {
              type empty;
            }
          }
        }
        list seq-list {
          tailf:cli-drop-node-name;
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          key "id";
          leaf id {
            tailf:cli-suppress-range;
            type uint16;
          }
          leaf policy {
            tailf:cli-drop-node-name;
            tailf:cli-hide-in-submode;
            type enumeration {
              enum "ipsec-isakmp";
              enum "ipsec-manual";
              enum "gdoi";
              enum "ckm";
            }
