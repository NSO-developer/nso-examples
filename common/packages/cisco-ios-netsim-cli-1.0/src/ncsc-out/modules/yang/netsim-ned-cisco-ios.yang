            type string;
          }
          leaf priority {
            type uint16;
          }
          leaf weight {
            type uint16;
          }
          leaf port {
            type uint32;
          }
          leaf txt {
            type string;
          }
          leaf ipv4addr {
            type inet:ipv4-address;
          }
          leaf ipv6addr {
            type inet:ipv6-address;
          }
