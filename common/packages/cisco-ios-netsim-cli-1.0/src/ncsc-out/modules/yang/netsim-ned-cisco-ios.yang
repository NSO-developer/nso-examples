  grouping router-lisp-af-grouping {
    leaf map-resolver {
      type empty;
    }
    container map-resolver-conf {
      tailf:cli-drop-node-name;
      container map-resolver {
        container map-request {
          container validate {
            container source {
              tailf:cli-compact-syntax;
              leaf registered {
                tailf:cli-optional-in-sequence;
                type empty;
              }
              container list {
                choice list-choice {
                  leaf ipv4 {
                    type string;
                  }
                  leaf ipv6 {
                    type string;
                  }
                }
              }
            }
          }
        }
      }
    }
