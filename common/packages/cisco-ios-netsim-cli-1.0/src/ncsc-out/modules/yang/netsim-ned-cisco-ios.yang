        container onep {
          container default {
            tailf:cli-compact-syntax;
            tailf:cli-delete-when-empty;
            presence "true";
            uses aaa-accounting-method-grouping;
          }
        }
        container system {
          container default {
            tailf:cli-compact-syntax;
            tailf:cli-delete-when-empty;
            presence "true";
            uses aaa-accounting-method-grouping;
          }
          leaf guarantee-first {
            type boolean;
          }
        }
        container suppress {
          leaf null-username {
            type empty;
          }
        }
        container session-duration {
          leaf ntp-adjusted {
            type empty;
          }
        }
        container jitter {
          leaf maximum {
            type uint32;
          }
        }
        container update {
          tailf:cli-compact-syntax;
          leaf newinfo {
            type empty;
          }
          leaf periodic {
            type uint32;
          }
          container jitter {
            tailf:cli-flatten-container;
            leaf maximum {
              type uint32;
            }
          }
        }
        container delay-start {
          presence "true";
          leaf all {
            type empty;
          }
        }
