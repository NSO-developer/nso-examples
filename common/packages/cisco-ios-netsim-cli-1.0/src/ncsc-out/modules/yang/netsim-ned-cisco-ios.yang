        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        leaf zone {
          tailf:cli-drop-node-name;
          type string;
        }
        choice summer-choice {
          case date-case {
            leaf date {
              type empty;
            }
            leaf date-start-month {
              tailf:cli-drop-node-name;
              type month-type;
            }
            leaf date-start-date {
              tailf:cli-drop-node-name;
              type uint8;
            }
            leaf date-start-year {
              tailf:cli-drop-node-name;
              type uint16;
            }
            leaf date-start-time {
              tailf:cli-drop-node-name;
              type hhmm-type;
            }
            leaf date-end-month {
              tailf:cli-drop-node-name;
              type month-type;
            }
            leaf date-end-date {
              tailf:cli-drop-node-name;
              type uint8;
            }
            leaf date-end-year {
              tailf:cli-drop-node-name;
              type uint16;
            }
            leaf date-end-time {
              tailf:cli-drop-node-name;
              type hhmm-type;
            }
            leaf date-offset {
              tailf:cli-drop-node-name;
              type uint16;
            }
          }
          case recurring-case {
            leaf recurring {
              type empty;
            }
            leaf start {
              tailf:cli-drop-node-name;
              type union {
                type uint8;
                type enumeration {
                  enum "first";
                  enum "last";
                }
              }
            }
            leaf start-day {
              tailf:cli-drop-node-name;
              type weekday-type;
            }
            leaf start-month {
              tailf:cli-drop-node-name;
              type month-type;
            }
            leaf start-time {
              tailf:cli-drop-node-name;
              type hhmm-type;
            }
            leaf end {
              tailf:cli-drop-node-name;
              type union {
                type uint8;
                type enumeration {
                  enum "first";
                  enum "last";
                }
              }
            }
            leaf end-day {
              tailf:cli-drop-node-name;
              type weekday-type;
            }
            leaf end-month {
              tailf:cli-drop-node-name;
              type month-type;
            }
            leaf end-time {
              tailf:cli-drop-node-name;
              type hhmm-type;
            }
            leaf offset {
              tailf:cli-drop-node-name;
              type uint16;
            }
          }
        }
