              leaf vlan {
                type uint16;
              }
            }
          }
        }
      }
      leaf host-mode {
        type enumeration {
          enum "multi-auth";
          enum "multi-domain";
          enum "multi-host";
          enum "single-host";
        }
      }
      leaf open {
        type empty;
      }
      leaf-list order {
        tailf:cli-flat-list-syntax;
        ordered-by user;
        type enumeration {
          enum "dot1x";
          enum "mab";
          enum "webauth";
        }
      }
      leaf-list priority {
        tailf:cli-flat-list-syntax;
        ordered-by user;
        type enumeration {
          enum "dot1x";
          enum "mab";
          enum "webauth";
        }
      }
      leaf port-control {
        type enumeration {
          enum "auto";
          enum "force-authorized";
          enum "force-unauthorized";
        }
      }
      leaf periodic {
        type empty;
      }
      container timer {
        leaf reauthenticate {
          type union {
            type uint16;
            type enumeration {
              enum "server";
            }
          }
        }
        container inactivity {
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          leaf value {
            tailf:cli-drop-node-name;
            type union {
              type uint16;
              type enumeration {
                enum "server";
              }
            }
          }
          leaf dynamic {
            type empty;
          }
