        container initial {
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          leaf host {
            tailf:cli-drop-node-name;
            type inet:host;
          }
          leaf port-number {
            tailf:cli-drop-node-name;
            type uint16;
          }
        }
        container partial {
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          leaf host {
            tailf:cli-drop-node-name;
            type inet:host;
          }
          leaf port-number {
            tailf:cli-drop-node-name;
            type uint16;
          }
        }
