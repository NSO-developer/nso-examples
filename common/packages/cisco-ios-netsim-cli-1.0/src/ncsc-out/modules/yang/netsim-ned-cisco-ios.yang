          leaf range {
            type uint8;
          }
        }
      }
      leaf computation-interval {
        type uint16;
      }
      leaf measurement-mode {
        type enumeration {
          enum "one-way";
          enum "two-way";
          enum "loopback";
        }
      }
      leaf burst-interval {
        type uint16;
      }
      leaf tos-dscp {
        type uint8;
      }
      container protocol {
        tailf:cli-add-mode;
        leaf pm-mpls {
          type empty;
        }
      }
    }
    container liveness-detection {
      tailf:cli-add-mode;
      leaf multiplier {
        type uint8;
      }
    }
