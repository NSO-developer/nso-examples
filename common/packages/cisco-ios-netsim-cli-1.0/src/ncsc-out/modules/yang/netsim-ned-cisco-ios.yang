    container access-group {
      leaf-list index {
        tailf:cli-drop-node-name;
        type uint32;
      }
      leaf-list name {
        type string;
      }
    }
    leaf any {
      type empty;
    }
    leaf-list class-map {
      type string;
    }
    leaf-list cos {
      tailf:cli-flat-list-syntax;
      type uint16;
    }
    container cos-inner {
      tailf:cli-drop-node-name;
      container cos {
        leaf-list inner {
          tailf:cli-flat-list-syntax;
          type uint16;
        }
      }
    }
    container destination-address {
      leaf-list mac {
        type string;
      }
    }
    leaf-list discard-class {
      type uint8;
    }
    leaf-list dscp {
      tailf:cli-flat-list-syntax;
      type ncs_rpc_notif_dscp-type;
    }
    container match-multi-line {
      tailf:cli-drop-node-name;
      list dscp {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        ordered-by user;
        key "name";
        leaf name {
          tailf:cli-multi-word-key;
          type string;
        }
      }
      list precedence {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        ordered-by user;
        key "name";
        leaf name {
          tailf:cli-multi-word-key;
          type string;
        }
      }
    }
    leaf fr-de {
      type empty;
    }
    leaf-list fr-dlci {
      type uint16;
    }
    leaf non-client-nrt {
      type empty;
    }
    container input {
      leaf-list vlan {
        type union {
          type uint16;
          type string;
        }
      }
    }
    list input-interface {
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      key "name";
      leaf name {
        tailf:cli-multi-word-key;
        type string;
      }
    }
    container ip {
      leaf-list dscp {
        tailf:cli-flat-list-syntax;
        type ncs_rpc_notif_dscp-type;
      }
      leaf-list precedence {
        tailf:cli-flat-list-syntax;
        type ncs_rpc_notif_precedence-type;
      }
      list rtp {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "port1 port2";
        leaf port1 {
          type uint16;
        }
        leaf port2 {
          type uint16;
        }
      }
    }
    container mpls {
      container experimental {
        leaf-list topmost {
          tailf:cli-flat-list-syntax;
          type uint16;
        }
      }
    }
    leaf-list precedence {
      tailf:cli-flat-list-syntax;
      type ncs_rpc_notif_precedence-type;
    }
    container protocol {
      container attribute {
        list category {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "category-type";
          leaf category-type {
            type enumeration {
              enum "voice-and-video";
              enum "database";
              enum "email";
              enum "browsing";
              enum "trojan";
              enum "gaming";
              enum "anonymizers";
              enum "backup-and-storage";
              enum "business-and-productivity-tools";
              enum "epayement";
              enum "file-sharing";
              enum "industrial-protocols";
              enum "instant-messaging";
              enum "inter-process-rpc";
              enum "internet-security";
              enum "layer3-over-ip";
              enum "location-based-services";
              enum "net-admin";
              enum "newsgroup";
              enum "other";
              enum "social-networking";
              enum "software-updates";
              enum "consumer-file-sharing";
              enum "consumer-internet";
              enum "consumer-messaging";
              enum "consumer-streaming";
            }
          }
        }
        list sub-category {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "name";
          leaf name {
            type string;
          }
        }
        list application-group {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "name";
          leaf name {
            type string;
          }
        }
        list traffic-class {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "traffic-class-type";
          leaf traffic-class-type {
            type enumeration {
              enum "broadcast-video";
              enum "bulk-data";
              enum "multimedia-conferencing";
              enum "multimedia-streaming";
              enum "network-control";
              enum "ops-admin-mgmt";
              enum "real-time-interactive";
              enum "signaling";
              enum "transactional-data";
              enum "voip-telephony";
            }
          }
        }
        list business-relevance {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "business-relevance-type";
          leaf business-relevance-type {
            type enumeration {
              enum "business-irrelevant";
              enum "business-relevant";
              enum "default";
            }
          }
        }
      }
      list protocol-list {
        tailf:cli-drop-node-name;
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "name";
        leaf name {
          type string;
        }
        list values {
          tailf:cli-drop-node-name;
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          ordered-by user;
          key "value";
          leaf value {
            tailf:cli-multi-word-key;
            type string;
          }
        }
      }
    }
    container packet {
      list length {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        ordered-by user;
        key "line";
        leaf line {
          tailf:cli-multi-word-key;
          type string;
        }
      }
    }
    leaf-list qos-group {
      type uint16;
    }
    container source-address {
      leaf-list mac {
        type string;
      }
    }
    container vlan-inner {
      tailf:cli-drop-node-name;
      container vlan {
        leaf-list inner {
          type union {
            type uint16;
            type string;
          }
        }
      }
    }
    leaf-list vlan {
      type union {
        type uint16;
        type string;
      }
    }
    container service {
      container instance {
        leaf-list ethernet {
          type string;
        }
      }
    }
    container security-group {
      list source {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "tag";
        leaf tag {
          type uint16;
        }
      }
      list destination {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "tag";
        leaf tag {
          type uint16;
        }
      }
    }
    container flow {
      list record {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "name";
        leaf name {
          type string;
        }
      }
    }
  }

  grouping ncs_rpc_notif_ip-name-server-grouping {
    list name-server-list {
      tailf:cli-drop-node-name;
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      ordered-by user;
      key "address";
      leaf address {
        type union {
          type inet:ipv4-address;
          type inet:ipv6-address;
        }
      }
    }
  }

  grouping ncs_rpc_notif_ip-host-grouping {
    list host-list {
      tailf:cli-drop-node-name;
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands;
      key "hostname";
      leaf hostname {
        type string;
      }
      leaf tcp-port-number {
        tailf:cli-drop-node-name;
        tailf:cli-optional-in-sequence;
        type uint16;
      }
      leaf-list ip-address1 {
        tailf:cli-drop-node-name;
        tailf:cli-flat-list-syntax;
        type inet:ipv4-address;
      }
    }
  }

  grouping ncs_rpc_notif_ip-dhcp-excluded-address-grouping {
    list low-list {
      tailf:cli-drop-node-name;
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      key "low";
      leaf low {
        type inet:ipv4-address;
      }
    }
    list low-high-list {
      tailf:cli-drop-node-name;
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      key "low high";
      leaf low {
        type inet:ipv4-address;
      }
      leaf high {
        type inet:ipv4-address;
      }
    }
  }

  grouping ncs_rpc_notif_ntp-peer-grouping {
    list peer-list {
      tailf:cli-drop-node-name;
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-compact-syntax;
      key "name";
      leaf name {
        type inet:host;
      }
      leaf burst {
        type empty;
      }
      leaf iburst {
        type empty;
      }
      leaf key {
        type uint32;
      }
      leaf maxpoll {
        type uint8;
      }
      leaf minpoll {
        type uint8;
      }
      leaf normal-sync {
        type empty;
      }
      leaf prefer {
        type empty;
      }
      container source {
        tailf:cli-flatten-container;
        tailf:cli-compact-syntax;
        uses ncs_rpc_notif_interface-name-grouping;
      }
      leaf version {
        type uint8;
      }
    }
  }

  grouping ncs_rpc_notif_sntp-server-grouping {
    list server-list {
      tailf:cli-drop-node-name;
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-compact-syntax;
      key "name";
      leaf name {
        type inet:host;
      }
      leaf key {
        type uint32;
      }
      leaf version {
        type uint8;
      }
    }
  }

  grouping ncs_rpc_notif_line-grouping {
    leaf location {
      tailf:cli-multi-value;
      type string;
    }
    leaf absolute-timeout {
      type uint32;
    }
    container access-class {
      list access-list {
        tailf:cli-drop-node-name;
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        key "direction";
        leaf direction {
          type enumeration {
            enum "in";
            enum "out";
          }
        }
        leaf access-list {
          tailf:cli-drop-node-name;
          tailf:cli-prefix-key;
          type ncs_rpc_notif_exp-ip-acl-type;
        }
        leaf vrf-also {
          type empty;
        }
      }
    }
    container access-class-vrf {
      tailf:cli-drop-node-name;
      list access-class {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        key "direction vrfname";
        leaf access-list {
          tailf:cli-drop-node-name;
          tailf:cli-prefix-key;
          type ncs_rpc_notif_exp-ip-acl-type;
        }
        leaf direction {
          type enumeration {
            enum "in";
            enum "out";
          }
        }
        leaf vrfname {
          type string;
        }
      }
    }
    leaf flush-at-activation {
      type boolean;
    }
    leaf special-character-bits {
      type uint8;
    }
    container activation-character-choice {
      tailf:cli-drop-node-name;
      choice activation-character-choice {
        leaf activation-character {
          type boolean;
        }
        container activation-character-conf {
          tailf:cli-drop-node-name;
          leaf activation-character {
            type union {
              type string;
              type uint8;
            }
          }
        }
      }
    }
    leaf escape-character {
      type union {
        type uint8;
        type enumeration {
          enum "BREAK";
          enum "DEFAULT";
          enum "NONE";
        }
      }
    }
    leaf disconnect-character {
      type uint8;
    }
    container script {
      leaf dialer {
        type string;
      }
    }
    container modem {
      leaf enable {
        type boolean;
      }
      leaf Dialin {
        type empty;
      }
      container InOut {
        presence "true";
        leaf hangup {
          type empty;
        }
      }
      leaf DTR-active {
        type empty;
      }
      leaf Host {
        type empty;
      }
      container autoconfigure {
        leaf discovery {
          type empty;
        }
        leaf type {
          type string;
        }
      }
    }
    leaf terminal-type {
      type string;
    }
    container exec-choice {
      tailf:cli-drop-node-name;
      choice exec-choice {
        leaf exec {
          type boolean;
        }
        container exec-conf {
          tailf:cli-drop-node-name;
          container exec {
            container prompt {
              leaf timestamp {
                type empty;
              }
            }
          }
        }
      }
    }
    container exec-timeout {
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands;
      leaf minutes {
        tailf:cli-drop-node-name;
        type uint32;
      }
      leaf seconds {
        tailf:cli-drop-node-name;
        type uint32;
      }
    }
    leaf exec-banner {
      type boolean;
    }
    leaf motd-banner {
      type boolean;
    }
    leaf refuse-message {
      type string;
    }
    leaf vacant-message {
      type string;
    }
    leaf international {
      type empty;
    }
    container timeout {
      container login {
        leaf response {
          type uint16;
        }
      }
    }
    leaf session-limit {
      type uint32;
    }
    container session-disconnect-warning {
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-siblings;
      }
      leaf seconds {
        tailf:cli-drop-node-name;
        type uint32;
      }
      leaf message {
        tailf:cli-multi-value;
        type string;
      }
    }
    container logging {
      container synchronous {
        tailf:cli-delete-when-empty;
        presence "true";
        leaf level {
          type union {
            type uint8;
            type enumeration {
              enum "all";
            }
          }
        }
      }
    }
    leaf rotary {
      type uint8;
    }
    container login {
      tailf:cli-delete-when-empty;
      presence "true";
      leaf local {
        type empty;
      }
    }
    container local-authentication {
      tailf:cli-drop-node-name;
      container login {
        leaf tacacs {
          type empty;
        }
        leaf authentication {
          type union {
            type string;
            type enumeration {
              enum "default";
            }
          }
        }
      }
    }
    leaf autohangup {
      type empty;
    }
    container autoselect {
      leaf during-login {
        type empty;
      }
      leaf ppp {
        type empty;
      }
    }
    container autocommand {
      leaf command {
        tailf:cli-drop-node-name;
        tailf:cli-multi-value;
        type string;
      }
    }
    container accounting {
      leaf exec {
        type union {
          type string;
          type enumeration {
            enum "default";
          }
        }
      }
      list commands {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        key "level";
        leaf level {
          type uint8;
        }
        leaf name {
          tailf:cli-drop-node-name;
          type union {
            type string;
            type enumeration {
              enum "default";
            }
          }
        }
      }
    }
    leaf logout-warning {
      type uint32;
    }
    container ip {
      leaf netmask-format {
        type enumeration {
          enum "bit-count";
          enum "decimal";
          enum "hexadecimal";
        }
      }
    }
    container ipv6 {
      list access-class {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        key "direction";
        leaf direction {
          type enumeration {
            enum "in";
            enum "out";
          }
        }
        leaf access-list {
          tailf:cli-drop-node-name;
          tailf:cli-prefix-key;
          type ncs_rpc_notif_exp-ip-acl-type;
        }
      }
      container access-class-vrf {
        tailf:cli-drop-node-name;
        list access-class {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "direction vrfname";
          leaf access-list {
            tailf:cli-drop-node-name;
            tailf:cli-prefix-key;
            type ncs_rpc_notif_exp-ip-acl-type;
          }
          leaf direction {
            type enumeration {
              enum "in";
              enum "out";
            }
          }
          leaf vrfname {
            type string;
          }
        }
      }
    }
    container authorization {
      leaf exec {
        type union {
          type enumeration {
            enum "default";
          }
          type string;
        }
      }
      list commands {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        key "level";
        leaf level {
          type uint8;
        }
        leaf name {
          tailf:cli-drop-node-name;
          type union {
            type string;
            type enumeration {
              enum "default";
            }
          }
        }
      }
    }
    container history {
      leaf size {
        type uint16;
      }
    }
    leaf full-help {
      type empty;
    }
    container password {
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands;
      // NCS expand uses statement
      leaf type {
        tailf:cli-drop-node-name;
        tailf:cli-optional-in-sequence;
        type enumeration {
          enum "0";
          enum "5";
          enum "6";
          enum "7";
        }
      }
      leaf secret {
        tailf:cli-drop-node-name;
        type string;
      }
    }
    container privilege {
      leaf level {
        type uint8;
      }
    }
    container session-timeout {
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands;
      leaf session-timeout-value {
        tailf:cli-drop-node-name;
        type uint16;
      }
      leaf output {
        type empty;
      }
    }
    leaf stopbits {
      type enumeration {
        enum "1";
        enum "1.5";
        enum "2";
      }
    }
    container telnet {
      leaf break-on-ip {
        type empty;
      }
      leaf transparent {
        type empty;
      }
    }
    leaf domain-lookup {
      type boolean;
    }
    container transport {
      leaf-list input {
        tailf:cli-flat-list-syntax;
        type enumeration {
          enum "all";
          enum "none";
          enum "ssh";
          enum "telnet";
          enum "lat";
          enum "pad";
          enum "udptn";
          enum "rlogin";
          enum "lapb-ta";
          enum "mop";
          enum "v120";
          enum "acercon";
          enum "nasi";
        }
      }
      leaf-list output {
        tailf:cli-flat-list-syntax;
        type enumeration {
          enum "all";
          enum "none";
          enum "ssh";
          enum "telnet";
          enum "lat";
          enum "pad";
          enum "udptn";
          enum "rlogin";
          enum "lapb-ta";
          enum "mop";
          enum "v120";
          enum "acercon";
          enum "nasi";
        }
      }
      leaf preferred {
        type enumeration {
          enum "none";
          enum "ssh";
          enum "telnet";
        }
      }
    }
    leaf speed {
      type uint32;
    }
    leaf rxspeed {
      type uint32;
    }
    leaf txspeed {
      type uint32;
    }
    container flowcontrol {
      choice flowcontrol-choice {
        container hardware {
          presence "true";
          leaf out {
            type empty;
          }
        }
        container software {
          presence "true";
        }
        container none {
          tailf:cli-drop-node-name;
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          leaf mode {
            tailf:cli-drop-node-name;
            type enumeration {
              enum "NONE";
            }
          }
          leaf lock {
            type empty;
          }
        }
      }
    }
    leaf length {
      type uint16;
    }
    leaf width {
      type uint16;
    }
    container media-type {
      leaf rj45 {
        type empty;
      }
    }
  }

  grouping ncs_rpc_notif_queue-size-grouping {
    leaf queue-size-1 {
      tailf:cli-drop-node-name;
      type uint8;
    }
    leaf queue-size-2 {
      tailf:cli-drop-node-name;
      type uint8;
    }
    leaf queue-size-3 {
      tailf:cli-drop-node-name;
      type uint8;
    }
    leaf queue-size-4 {
      tailf:cli-drop-node-name;
      type uint8;
    }
    leaf queue-size-5 {
      tailf:cli-drop-node-name;
      type uint8;
    }
    leaf queue-size-6 {
      tailf:cli-drop-node-name;
      type uint8;
    }
    leaf queue-size-7 {
      tailf:cli-drop-node-name;
      type uint8;
    }
    leaf queue-size-8 {
      tailf:cli-drop-node-name;
      type uint8;
    }
  }

  grouping ncs_rpc_notif_interface-common-pre-grouping {
    leaf mac-address {
      type string;
    }
    leaf description {
      tailf:cli-multi-value;
      type string;
    }
    container backup {
      container delay {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        leaf enable-delay-period {
          tailf:cli-drop-node-name;
          type union {
            type uint32;
            type enumeration {
              enum "never";
            }
          }
        }
        leaf disable-delay-period {
          tailf:cli-drop-node-name;
          type union {
            type uint32;
            type enumeration {
              enum "never";
            }
          }
        }
      }
      container interface {
        uses ncs_rpc_notif_interface-name-grouping;
      }
    }
    list glbp {
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      key "group-number";
      leaf group-number {
        type uint16;
      }
      leaf ip {
        type inet:ipv4-address;
      }
      container ip-secondary-list {
        tailf:cli-drop-node-name;
        list ip {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "address";
          leaf address {
            type inet:ipv4-address;
          }
          leaf secondary {
            type empty;
          }
        }
      }
      container timers {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        container hellotime {
          tailf:cli-drop-node-name;
          tailf:cli-flatten-container;
          tailf:cli-compact-syntax;
          choice hellotime-choice {
            leaf seconds {
              tailf:cli-drop-node-name;
              type uint8;
            }
            leaf msec {
              type uint32;
            }
          }
        }
        container holdtime {
          tailf:cli-drop-node-name;
          tailf:cli-flatten-container;
          tailf:cli-compact-syntax;
          choice holdtime-choice {
            leaf seconds {
              tailf:cli-drop-node-name;
              type uint8;
            }
            leaf msec {
              type uint32;
            }
          }
        }
      }
      leaf priority {
        type uint8;
      }
      container preempt {
        tailf:cli-delete-when-empty;
        presence "true";
        container delay {
          leaf minimum {
            type uint32;
          }
        }
      }
      leaf load-balancing {
        type enumeration {
          enum "host-dependent";
          enum "round-robin";
          enum "weighted";
        }
      }
      container authentication {
        leaf text {
          type string;
        }
      }
      container weighting {
        list track {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "id";
