        }
        leaf tb-vlan2 {
          type uint16;
        }
        leaf parent {
          type uint16;
        }
        leaf backupcrf {
          type enumeration {
            enum "disable";
            enum "enable";
          }
        }
      }
      list configuration {
        tailf:cli-range-list-syntax;
        key "id";
        leaf id {
          type uint16;
        }
        container ip {
