                  enum "0";
                  enum "5";
                  enum "6";
                  enum "7";
                }
              }
              leaf secret {
                tailf:cli-drop-node-name;
                type string;
              }
              leaf timeout {
                type uint16;
              }
            }
          }
          leaf text {
