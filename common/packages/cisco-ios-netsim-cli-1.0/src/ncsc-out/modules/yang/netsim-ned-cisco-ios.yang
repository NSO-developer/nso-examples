        uses router-rip-redistribute-grouping;
        uses redistribute-ospf-match-grouping;
      }
      container static {
        tailf:cli-compact-syntax;
        tailf:cli-delete-when-empty;
        presence "Static routes";
        uses router-rip-redistribute-grouping;
      }
      container rip {
        tailf:cli-compact-syntax;
        presence "true";
        uses router-rip-redistribute-grouping;
      }
      container lisp {
        tailf:cli-compact-syntax;
        presence "true";
        uses router-rip-redistribute-grouping;
      }
    }
    container timers {
      container basic {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        leaf updates {
          tailf:cli-drop-node-name;
          type uint32;
        }
        leaf invalid {
          tailf:cli-drop-node-name;
          type uint32;
        }
        leaf holddown {
          tailf:cli-drop-node-name;
          type uint32;
        }
        leaf flush {
          tailf:cli-drop-node-name;
          type uint32;
        }
        leaf sleep {
          tailf:cli-drop-node-name;
          type uint32;
        }
      }
    }
    leaf version {
      type uint8;
    }
    container traffic-share {
      container min {
        leaf across-interfaces {
          type empty;
        }
      }
    }
  }

  grouping router-rip-grouping {
    uses router-rip-af-grouping;
    uses passive-interface-grouping;
    leaf output-delay {
      type uint8;
    }
    leaf input-queue {
      type uint16;
    }
    leaf flash-update-threshold {
      type uint8;
    }
  }

  grouping router-rip-redistribute-grouping {
    leaf metric {
      type union {
        type uint8;
        type enumeration {
          enum "transparent";
        }
      }
    }
    leaf route-map {
      type string;
    }
  }

  grouping router-eigrp-redistribute-grouping {
    container metric {
      tailf:cli-break-sequence-commands;
      tailf:cli-flatten-container;
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-siblings;
      }
      leaf bandwidth-metric {
        tailf:cli-drop-node-name;
        type uint32;
      }
      leaf delay-metric {
        tailf:cli-drop-node-name;
        type uint32;
      }
      leaf reliability-metric {
        tailf:cli-drop-node-name;
        type uint8;
      }
      leaf effective-bandwidth-metric {
        tailf:cli-drop-node-name;
        type uint8;
      }
      leaf mtu-bytes {
        tailf:cli-drop-node-name;
        type uint16;
      }
    }
    leaf route-map {
      type string;
    }
  }

  grouping router-eigrp-grouping {
    container bfd {
      leaf all-interfaces {
        type empty;
      }
      list interface {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "name";
        leaf name {
          type string;
        }
      }
    }
    container metric {
      leaf maximum-hops {
        type uint8;
      }
      container weights {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        leaf tos {
          tailf:cli-drop-node-name;
          type uint8;
        }
        leaf k1 {
          tailf:cli-drop-node-name;
          type uint8;
        }
        leaf k2 {
          tailf:cli-drop-node-name;
          type uint8;
        }
        leaf k3 {
          tailf:cli-drop-node-name;
          type uint8;
        }
        leaf k4 {
          tailf:cli-drop-node-name;
          type uint8;
        }
        leaf k5 {
          tailf:cli-drop-node-name;
          type uint8;
        }
      }
    }
    container network-ip {
      tailf:cli-drop-node-name;
      list network {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "ip";
        leaf ip {
          type inet:ipv4-address;
        }
      }
    }
    list network {
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      key "ip mask";
      leaf ip {
        type inet:ipv4-address;
      }
      leaf mask {
        type inet:ipv4-address;
      }
    }
    container neighbor {
      list neighbor-list {
        tailf:cli-drop-node-name;
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "address interface";
        leaf address {
          type inet:ipv4-address;
        }
        leaf interface {
          type string;
        }
      }
    }
    container eigrp {
      leaf router-id {
        type inet:ipv4-address;
      }
      container stub {
        tailf:cli-compact-syntax;
        leaf connected {
          type empty;
        }
        leaf static {
          type empty;
        }
        leaf summary {
          type empty;
        }
        leaf redistributed {
          type empty;
        }
      }
      leaf stub-site {
        type string;
      }
      leaf log-neighbor-changes {
        type boolean;
      }
    }
  }

  grouping router-eigrp-base-grouping {
    uses router-distribute-list-grouping;
    leaf maximum-secondary-paths {
      type uint8;
    }
    leaf variance {
      type uint8;
    }
    container timers {
      container nsf {
        leaf converge {
          type uint8;
        }
      }
    }
    leaf maximum-paths {
      type uint8;
    }
    container default-metric {
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands;
      leaf bandwidth {
        tailf:cli-drop-node-name;
        type uint32;
      }
      leaf delay {
        tailf:cli-drop-node-name;
        type uint32;
      }
      leaf reliability {
        tailf:cli-drop-node-name;
        type uint8;
      }
      leaf loading {
        tailf:cli-drop-node-name;
        type uint8;
      }
      leaf mtu {
        tailf:cli-drop-node-name;
        type uint16;
      }
    }
    list summary-metric {
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-siblings;
      }
      key "prefix";
      leaf prefix {
        type ios:ipv4-prefix;
      }
      leaf bandwidth {
        tailf:cli-optional-in-sequence;
        tailf:cli-drop-node-name;
        type uint32;
      }
      leaf delay {
        tailf:cli-drop-node-name;
        type uint32;
      }
      leaf reliability {
        tailf:cli-drop-node-name;
        type uint8;
      }
      leaf load {
        tailf:cli-drop-node-name;
        type uint8;
      }
      leaf mtu {
        tailf:cli-drop-node-name;
        type uint16;
      }
      leaf distance {
        type uint8;
      }
    }
    uses router-offset-list-grouping;
    container redistribute {
      container connected {
        tailf:cli-compact-syntax;
        tailf:cli-delete-when-empty;
        presence "true";
        uses router-eigrp-redistribute-grouping;
      }
      container bgp {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-all-siblings;
        }
        leaf as-no {
          tailf:cli-drop-node-name;
          type bgp-as-no-type;
        }
        uses router-eigrp-redistribute-grouping;
      }
      list eigrp {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        key "as-no";
        leaf as-no {
          type eigrp-as-no-type;
        }
        uses router-eigrp-redistribute-grouping;
      }
      container isis {
        tailf:cli-compact-syntax;
        tailf:cli-delete-when-empty;
        presence "true";
        list isis-list {
          tailf:cli-drop-node-name;
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-compact-syntax;
          key "name";
          leaf name {
            type string;
          }
          leaf level {
            tailf:cli-drop-node-name;
            type isis-level-type;
          }
          uses router-eigrp-redistribute-grouping;
        }
        leaf level {
          tailf:cli-drop-node-name;
          type isis-level-type;
        }
        uses router-eigrp-redistribute-grouping;
      }
      container iso-igrp {
        tailf:cli-delete-when-empty;
        presence "true";
        list iso-igrp-list {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-drop-node-name;
          key "name";
          leaf name {
            type string;
          }
          uses router-eigrp-redistribute-grouping;
        }
        uses router-eigrp-redistribute-grouping;
      }
      container mobile {
        tailf:cli-compact-syntax;
        tailf:cli-delete-when-empty;
        presence "true";
        uses router-eigrp-redistribute-grouping;
      }
      container odr {
        tailf:cli-compact-syntax;
        tailf:cli-delete-when-empty;
        presence "true";
        uses router-eigrp-redistribute-grouping;
      }
      list ospf {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        key "id";
        leaf id {
          tailf:cli-suppress-range;
          type uint16;
        }
        leaf vrf {
          type string;
        }
        uses redistribute-ospf-match-grouping;
        uses router-eigrp-redistribute-grouping;
      }
      container static {
        tailf:cli-compact-syntax;
        tailf:cli-delete-when-empty;
        presence "true";
        uses router-eigrp-redistribute-grouping;
      }
      container rip {
        tailf:cli-compact-syntax;
        tailf:cli-delete-when-empty;
        presence "true";
        uses router-eigrp-redistribute-grouping;
      }
    }
    container distance {
      container eigrp {
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        leaf internal-distance {
          tailf:cli-drop-node-name;
          type uint8;
        }
        leaf external-distance {
          tailf:cli-drop-node-name;
          type uint8;
        }
      }
      list distance-list {
        tailf:cli-drop-node-name;
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        key "ip-address wildcard-mask";
        leaf ip-address {
          type inet:ipv4-address;
        }
        leaf wildcard-mask {
          type inet:ipv4-address;
        }
        leaf weight {
          tailf:cli-drop-node-name;
          tailf:cli-prefix-key;
          type uint8;
        }
        leaf access-list {
          tailf:cli-drop-node-name;
          type std-ip-acl-type;
        }
      }
    }
    leaf auto-summary {
      type empty;
    }
    uses passive-interface-grouping;
    leaf nsf {
      type empty;
    }
  }

  grouping router-eigrp-af-virtual-instance-grouping {
    list af-interface {
      tailf:cli-break-sequence-commands;
      ordered-by user;
      key "name";
      leaf name {
        type string;
      }
      list summary-address {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        key "ip mask";
        leaf ip {
          type inet:ipv4-address;
        }
        leaf mask {
          type inet:ipv4-address;
        }
        leaf leak-map {
          type string;
        }
      }
      container summary-address-ipv6 {
        tailf:cli-drop-node-name;
        list summary-address {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-compact-syntax;
          key "ipv6";
          leaf ipv6 {
            type ipv6-prefix;
          }
          leaf leak-map {
            type string;
          }
        }
      }
      container authentication {
        container mode {
          leaf md5 {
            type empty;
          }
        }
        leaf key-chain {
          type string;
        }
      }
      leaf hello-interval {
        type uint16;
      }
      leaf hold-time {
        type uint16;
      }
      leaf next-hop-self {
        type boolean;
      }
      leaf shutdown {
        type boolean;
      }
      leaf passive-interface {
        type empty;
      }
      leaf split-horizon {
        type boolean;
      }
      container stub-site {
        leaf wan-interface {
          type empty;
        }
      }
    }
    container topology {
      container base {
        tailf:cli-add-mode;
        presence "true";
        uses router-eigrp-base-grouping;
      }
    }
    uses router-eigrp-grouping;
    container maximum-prefix {
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-all-siblings;
      }
      leaf max-prefix-no {
        tailf:cli-drop-node-name;
        type uint32;
      }
      leaf threshold {
        tailf:cli-drop-node-name;
        tailf:cli-break-sequence-commands;
        type uint8;
      }
      leaf restart {
        type uint16;
      }
      leaf warning-only {
        type empty;
      }
    }
  }

  grouping spf-intervals-grouping {
    leaf interval {
      tailf:cli-drop-node-name;
      type uint8;
    }
    leaf initial-wait {
      tailf:cli-drop-node-name;
      type uint32;
    }
    leaf minimum-wait {
      tailf:cli-drop-node-name;
      type uint32;
    }
  }

  grouping router-isis-authenticate-snp-grouping {
    leaf authenticate {
      type empty;
    }
    leaf snp {
      type enumeration {
        enum "send-only";
        enum "validate";
      }
    }
  }

  grouping lsp-gen-interval-grouping {
    leaf interval {
      tailf:cli-drop-node-name;
      type uint32;
    }
    leaf initial-wait {
      tailf:cli-drop-node-name;
      type uint32;
    }
    leaf wait {
      tailf:cli-drop-node-name;
      type uint32;
    }
  }

  grouping set-overload-bit-suppress-grouping {
    leaf external {
      tailf:cli-break-sequence-commands;
      type empty;
    }
    leaf interlevel {
      type empty;
    }
  }

  grouping redist-level-grouping {
    leaf level {
      tailf:cli-drop-node-name;
      tailf:cli-break-sequence-commands;
      type isis-level-type;
    }
  }

  grouping router-isis-redistribute-grouping {
    leaf metric {
      type uint32;
    }
    leaf route-map {
      type string;
    }
    leaf metric-type {
      type enumeration {
        enum "external";
        enum "internal";
      }
    }
    uses router-isis-level-grouping;
  }

  grouping router-isis-af-redistribute-grouping {
    leaf metric {
      type uint32;
    }
    leaf metric-type {
      type enumeration {
        enum "external";
        enum "internal";
      }
    }
    uses router-isis-level-grouping;
    leaf route-map {
      type string;
    }
    leaf include-connected {
      type empty;
    }
  }

  grouping isis-redist-ospf-match-grouping {
    uses redist-level-grouping;
    leaf metric {
      type uint32;
    }
    leaf route-map {
      type string;
    }
  }

  grouping router-isis-interface-grouping {
    container authentication {
      list mode {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        key "level";
        leaf name {
          tailf:cli-drop-node-name;
          tailf:cli-prefix-key;
          type enumeration {
            enum "md5";
            enum "text";
          }
        }
        leaf level {
          type enumeration {
            enum "level-1";
            enum "level-2";
          }
        }
      }
      list key-chain {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        key "level";
        leaf name {
          tailf:cli-drop-node-name;
          tailf:cli-prefix-key;
          type string;
        }
        leaf level {
          type enumeration {
            enum "level-1";
            enum "level-2";
          }
        }
      }
      list send-only {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "level";
        leaf level {
          type enumeration {
            enum "level-1";
            enum "level-2";
          }
        }
      }
    }
  }

  grouping router-isis-af-early-grouping {
    container metric-style {
      choice metric-style-choice {
        container narrow {
          tailf:cli-compact-syntax;
          tailf:cli-delete-when-empty;
          presence "true";
          uses router-isis-metric-type-grouping;
        }
        container transition {
          tailf:cli-compact-syntax;
          tailf:cli-delete-when-empty;
          presence "true";
          leaf level {
            tailf:cli-drop-node-name;
            type isis-level-type;
          }
        }
        container wide {
          tailf:cli-compact-syntax;
          tailf:cli-delete-when-empty;
          presence "true";
          uses router-isis-metric-type-grouping;
        }
      }
    }
  }

  grouping router-isis-metric-type-grouping {
    leaf transition {
      type empty;
    }
    leaf level {
      tailf:cli-drop-node-name;
      type isis-level-type;
    }
  }

  grouping router-isis-af-late-grouping {
    leaf adjacency-check {
      type boolean;
    }
    container set-overload-bit {
      tailf:cli-delete-when-empty;
      presence "true";
      choice set-overload-bit-choice {
        container on-startup {
          choice on-startup-choice {
            container time {
              tailf:cli-drop-node-name;
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands;
              leaf time {
                tailf:cli-drop-node-name;
                type uint32;
              }
              leaf suppress {
                type empty;
              }
              uses set-overload-bit-suppress-grouping;
            }
            container wait-for-bgp {
              presence "true";
              container suppress {
                tailf:cli-compact-syntax;
                tailf:cli-sequence-commands;
                uses set-overload-bit-suppress-grouping;
              }
            }
          }
        }
        container suppress {
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          uses set-overload-bit-suppress-grouping;
        }
      }
    }
    container spf-interval {
      tailf:cli-compact-syntax;
      choice spf-interval-choice {
        list level-1-2 {
          tailf:cli-drop-node-name;
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          key "level";
          leaf level {
            type enumeration {
              enum "level-1";
              enum "level-2";
            }
          }
          uses spf-intervals-grouping;
        }
        container intervals {
          tailf:cli-drop-node-name;
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          uses spf-intervals-grouping;
        }
      }
    }
    container prc-interval {
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands;
      leaf interval {
        tailf:cli-drop-node-name;
        type uint32;
      }
      leaf initial-wait {
        tailf:cli-drop-node-name;
        type uint32;
      }
      leaf minimum-wait {
        tailf:cli-drop-node-name;
        type uint32;
      }
    }
    choice metric-choice {
      case default-case {
        container metric {
          leaf default {
            tailf:cli-drop-node-name;
            type uint32;
          }
        }
      }
      case level-case {
        container metric-level {
          tailf:cli-drop-node-name;
          list metric {
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands;
            key "level";
            leaf level {
              type enumeration {
                enum "level-1";
                enum "level-2";
              }
            }
            leaf default {
              tailf:cli-drop-node-name;
              tailf:cli-prefix-key;
              type uint32;
            }
          }
        }
      }
    }
    leaf maximum-paths {
      type uint32;
    }
    container default-information {
      container originate {
        tailf:cli-delete-when-empty;
        presence "true";
        leaf route-map {
          type string;
        }
      }
    }
  }

  grouping router-isis-grouping {
    leaf vrf {
      type string;
    }
    container protocol {
      leaf shutdown {
        type empty;
      }
    }
    leaf max-area-addresses {
      type uint32;
    }
    list net {
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      key "tag";
      leaf tag {
        type string;
      }
    }
    leaf is-type {
      type enumeration {
        enum "level-1";
        enum "level-1-2";
        enum "level-2-only";
      }
    }
    container advertise {
      leaf passive-only {
        type empty;
      }
      container link {
