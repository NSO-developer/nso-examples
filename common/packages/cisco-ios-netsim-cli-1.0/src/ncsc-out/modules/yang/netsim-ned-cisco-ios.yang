    container global-address-family {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      container ipv4 {
        container multicast {
          tailf:cli-add-mode;
          container topology {
            container base {
              tailf:cli-add-mode;
