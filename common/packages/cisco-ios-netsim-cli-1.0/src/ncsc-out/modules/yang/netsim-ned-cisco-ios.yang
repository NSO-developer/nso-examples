          type inet:ipv4-address;
          type ios:ipv6-prefix;
        }
      }
      leaf mask {
        type inet:ipv4-address;
      }
      choice option-choice {
        leaf backdoor {
          type empty;
        }
        leaf route-map {
          type string;
        }
      }
    }
    container network-address {
      tailf:cli-drop-node-name;
      list network {
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        key "number";
        leaf number {
          type union {
            type inet:ipv4-address;
            type ios:ipv6-prefix;
          }
        }
        choice option-choice {
          leaf backdoor {
            type empty;
          }
          leaf route-map {
