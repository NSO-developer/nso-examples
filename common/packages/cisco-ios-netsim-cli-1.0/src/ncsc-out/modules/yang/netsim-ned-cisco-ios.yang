    container mdns-sd {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      list service-list {
        key "name";
        leaf name {
          type string;
        }
        leaf direction {
          tailf:cli-drop-node-name;
          tailf:cli-hide-in-submode;
          type enumeration {
            enum "IN";
            enum "OUT";
          }
        }
        list match {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "name";
          leaf name {
            type string;
          }
        }
      }
      list service-policy {
        key "name";
        leaf name {
          type string;
        }
        list service-list {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          key "direction";
          leaf direction {
            type enumeration {
              enum "IN";
              enum "OUT";
            }
          }
          leaf name {
            tailf:cli-drop-node-name;
            tailf:cli-prefix-key;
            type string;
          }
        }
      }
      list service-definition {
        key "name";
        leaf name {
          type string;
        }
        uses description-grouping;
        leaf service-type {
          type string;
        }
      }
    }
    container bfd {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      container map {
        container ipv4 {
          list list {
            tailf:cli-drop-node-name;
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "destination source";
            leaf destination {
              type ios:ipv4-prefix;
            }
            leaf source {
              type ios:ipv4-prefix;
            }
            leaf bfd-template {
              tailf:cli-drop-node-name;
              type string;
            }
          }
          list vrf {
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "name destination source";
            leaf name {
              type string;
            }
            leaf destination {
              type ios:ipv4-prefix;
            }
            leaf source {
              type ios:ipv4-prefix;
            }
            leaf bfd-template {
              tailf:cli-drop-node-name;
              type string;
            }
          }
          container src-vrf {
            tailf:cli-drop-node-name;
            list vrf {
              tailf:cli-suppress-mode;
              tailf:cli-delete-when-empty;
              key "name destination vrf source";
              leaf name {
                type string;
              }
              leaf destination {
                type ios:ipv4-prefix;
              }
              leaf vrf {
                type string;
              }
              leaf source {
                type ios:ipv4-prefix;
              }
              leaf bfd-template {
                tailf:cli-drop-node-name;
                type string;
              }
            }
          }
        }
        container ipv6 {
          list list {
            tailf:cli-drop-node-name;
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "destination source";
            leaf destination {
              type ipv6-prefix;
            }
            leaf source {
              type ipv6-prefix;
            }
            leaf bfd-template {
              tailf:cli-drop-node-name;
              type string;
            }
          }
        }
      }
      container snmp {
        container traps {
          leaf more {
            type empty;
          }
        }
      }
      leaf fast-timers-on-slow-interface {
        type empty;
      }
      leaf slow-timers {
        type uint16;
      }
    }
    container bfd-template {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      list single-hop {
        key "name";
        leaf name {
          type string;
        }
        uses bfd-template-grouping;
      }
      list multi-hop {
        key "name";
        leaf name {
          type string;
        }
        uses bfd-template-grouping;
      }
    }
    leaf process-max-time {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      type uint8;
