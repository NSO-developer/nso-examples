        }
        leaf service-node-group {
          type string;
        }
        leaf service-policy {
          type string;
        }
        container vrf {
          choice c-type {
            leaf name {
              type string;
            }
            leaf default {
              type empty;
            }
            leaf global {
              type empty;
            }
          }
        }
        leaf enable {
          type empty;
        }
      }
    }
