        container class-name {
          tailf:cli-drop-node-name;
          list class {
            ordered-by user;
            key "name";
            leaf type {
              tailf:cli-prefix-key;
              type enumeration {
                enum "traffic";
              }
            }
            leaf name {
              type string;
            }
            container timeout {
              leaf idle {
                type uint32;
              }
              leaf absolute {
                type uint32;
              }
            }
            container accounting {
              container aaa {
                leaf list {
                  type string;
                }
              }
            }
          }
        }
        container class-default {
          tailf:cli-drop-node-name;
          list class {
            key "name";
            leaf type {
              tailf:cli-prefix-key;
              type enumeration {
                enum "traffic";
              }
            }
            leaf name {
              type enumeration {
                enum "default";
              }
            }
            leaf direction {
              tailf:cli-drop-node-name;
              tailf:cli-hide-in-submode;
              type enumeration {
                enum "in-out";
                enum "input";
                enum "output";
              }
            }
            leaf drop {
              type empty;
            }
          }
        }
      }
    }
    container policy-map-control {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      tailf:cli-drop-node-name;
      list policy-map {
        tailf:cli-sequence-commands;
        key "name";
        leaf name {
          type string;
        }
        leaf type {
          tailf:cli-prefix-key;
          type enumeration {
            enum "control";
          }
        }
        container class-name {
          tailf:cli-break-sequence-commands;
          tailf:cli-drop-node-name;
          list class {
            tailf:cli-sequence-commands;
            key "name";
            leaf type {
              tailf:cli-prefix-key;
              type enumeration {
                enum "control";
              }
            }
            leaf name {
              type string;
            }
            leaf event {
              tailf:cli-hide-in-submode;
              type pm-class-type-control-event-type;
            }
            uses policy-map-type-control-class-grouping;
          }
        }
        container class-always {
          tailf:cli-drop-node-name;
          list class {
            tailf:cli-sequence-commands;
            key "name event";
            leaf type {
              tailf:cli-prefix-key;
              type enumeration {
                enum "control";
              }
            }
            leaf name {
              type enumeration {
                enum "always";
              }
            }
            leaf event {
              type pm-class-type-control-event-type;
            }
            uses policy-map-type-control-class-grouping;
          }
        }
      }
