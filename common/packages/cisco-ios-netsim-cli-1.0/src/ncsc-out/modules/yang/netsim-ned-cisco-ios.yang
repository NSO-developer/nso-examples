          type string;
        }
        leaf description {
          type string;
        }
        list appnav-controller {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "ip-address";
          leaf ip-address {
            type inet:ipv4-address;
          }
        }
      }
      list service-context {
        key "name";
