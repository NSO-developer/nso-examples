              enum "mux-1483routed";
              enum "mux-dot1q-rbe";
              enum "mux-pppoa";
              enum "mux-rbe";
              enum "snap-1483routed";
              enum "snap-dot1q-rbe";
              enum "snap-pppoa";
              enum "snap-rbe";
            }
          }
        }
        leaf user-defined {
          type int8;
        }
      }
    }
