            tailf:cli-hide-in-submode;
            tailf:cli-optional-in-sequence;
            type string;
          }
          leaf profile {
            tailf:cli-hide-in-submode;
            tailf:cli-optional-in-sequence;
            type string;
          }
          leaf description {
            tailf:cli-break-sequence-commands;
            tailf:cli-multi-value;
            type string;
          }
          container set {
            container session-key {
              container inbound {
                container esp {
                  tailf:cli-compact-syntax;
                  tailf:cli-sequence-commands {
                    tailf:cli-reset-siblings;
                  }
                  leaf spi {
                    tailf:cli-drop-node-name;
                    type uint32;
                  }
                  leaf cipher {
                    tailf:cli-optional-in-sequence;
                    type string;
                  }
                  leaf authenticator {
                    type string;
                  }
                }
                container ah {
                  tailf:cli-compact-syntax;
                  tailf:cli-sequence-commands {
                    tailf:cli-reset-siblings;
                  }
                  leaf spi {
                    tailf:cli-drop-node-name;
                    type uint32;
                  }
                  leaf key {
                    tailf:cli-drop-node-name;
                    type string;
                  }
                }
              }
              container outbound {
                container esp {
                  tailf:cli-compact-syntax;
                  tailf:cli-sequence-commands {
                    tailf:cli-reset-siblings;
                  }
                  leaf spi {
                    tailf:cli-drop-node-name;
                    type uint32;
                  }
                  leaf cipher {
                    tailf:cli-optional-in-sequence;
                    type string;
                  }
                  leaf authenticator {
                    type string;
                  }
                }
                container ah {
                  tailf:cli-compact-syntax;
                  tailf:cli-sequence-commands {
                    tailf:cli-reset-siblings;
                  }
                  leaf spi {
                    tailf:cli-drop-node-name;
                    type uint32;
                  }
                  leaf key {
                    tailf:cli-drop-node-name;
                    type string;
                  }
                }
              }
            }
            leaf-list transform-set {
              tailf:cli-flat-list-syntax;
              type string;
            }
            leaf isakmp-profile {
              type string;
            }
            leaf ikev2-profile {
              type string;
            }
            leaf peer-default {
              type inet:host;
            }
            leaf-list peer {
              type inet:host;
            }
            container security-association {
              container level {
                leaf per-host {
                  type empty;
                }
              }
              leaf dfbit {
                type enumeration {
                  enum "clear";
                  enum "copy";
                  enum "set";
                }
              }
              container lifetime {
                leaf kilobytes {
                  type union {
                    type uint32;
                    type enumeration {
                      enum "disable";
                    }
                  }
                }
                choice days-seconds-choice {
                  leaf days {
                    type uint8;
                  }
                  leaf seconds {
                    type uint32;
                  }
                }
              }
              container idle-time {
                tailf:cli-compact-syntax;
                tailf:cli-sequence-commands {
                  tailf:cli-reset-siblings;
                }
                leaf seconds {
                  tailf:cli-drop-node-name;
                  type uint32;
                }
                leaf default {
                  type empty;
                }
              }
              container replay {
                leaf disable {
                  type empty;
                }
                leaf window-size {
                  type enumeration {
                    enum "1024";
                    enum "512";
                    enum "256";
                    enum "128";
                    enum "64";
                  }
                }
              }
              container dummy {
                choice dummy-choice {
                  leaf pps {
                    type uint8;
                  }
                  leaf seconds {
                    type uint16;
                  }
                }
              }
              leaf ecn {
                type enumeration {
                  enum "discard";
                  enum "propagate";
                }
              }
            }
            leaf pfs {
              type isakmp-pfs-type;
            }
            container reverse-route {
              leaf distance {
                type uint8;
              }
              leaf tag {
                type uint32;
              }
            }
            leaf group {
              type string;
            }
          }
          container gdoi-set {
            tailf:cli-break-sequence-commands;
            tailf:cli-drop-node-name;
            container set {
              leaf group {
                type string;
              }
            }
          }
          container match {
            leaf address {
              type ext-ip-acl-type;
            }
          }
          container reverse-route {
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands;
            tailf:cli-delete-when-empty;
            presence "true";
            leaf remote-peer {
              tailf:cli-optional-in-sequence;
              type inet:ipv4-address;
            }
            leaf gateway {
              tailf:cli-optional-in-sequence;
              type empty;
            }
            leaf static {
              type empty;
            }
          }
          container qos {
            leaf pre-classify {
              type empty;
            }
          }
        }
      }
      container ssl {
        list proposal {
          key "name";
          leaf name {
            type string;
          }
          leaf-list protection {
            tailf:cli-flat-list-syntax;
            type enumeration {
              enum "rsa-3des-ede-sha1";
              enum "rsa-rc4128-md5";
              enum "rsa-aes128-sha1";
              enum "rsa-aes256-sha1";
            }
          }
        }
        container authorization {
          list policy {
            key "name";
            leaf name {
              type string;
            }
            leaf pool {
              type string;
            }
            container dns {
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands {
                tailf:cli-reset-siblings;
              }
              leaf primary-server {
                tailf:cli-drop-node-name;
                type inet:ipv4-address;
              }
              leaf secondary-server {
                tailf:cli-drop-node-name;
                type inet:ipv4-address;
              }
            }
            leaf banner {
              tailf:cli-multi-value;
              type string;
            }
            leaf def-domain {
              type string;
            }
          }
        }
        list policy {
          key "name";
          leaf name {
            type string;
          }
          container ssl {
            leaf proposal {
              type string;
            }
          }
          container pki {
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            leaf trustpoint {
              type string;
            }
            leaf sign {
              type empty;
            }
          }
          container ip {
            container address {
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands {
                tailf:cli-reset-siblings;
              }
              leaf local {
                type inet:ipv4-address;
              }
              leaf port {
                type union {
                  type uint16;
                  type uint16;
                }
              }
            }
          }
          leaf shutdown {
            type empty;
          }
        }
        list profile {
          key "name";
          leaf name {
            type string;
          }
          container match {
            leaf policy {
              type string;
            }
            leaf url {
              type string;
            }
          }
          container aaa {
            container authentication {
              leaf list {
                type string;
              }
            }
            container authorization {
              container user {
                tailf:cli-compact-syntax;
                tailf:cli-sequence-commands {
                  tailf:cli-reset-siblings;
                }
                leaf list {
                  type string;
                }
                leaf aaa-username {
                  tailf:cli-drop-node-name;
                  type string;
                }
              }
            }
          }
          container authentication {
            container remote {
              leaf user-credentials {
                type empty;
              }
            }
          }
          leaf shutdown {
            type empty;
          }
        }
      }
      list tls-tunnel {
        key "name";
        leaf name {
          type string;
        }
        list server {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-compact-syntax;
          key "protocol address";
          leaf protocol {
            type enumeration {
              enum "ipv4";
              enum "ipv6";
            }
          }
          leaf address {
            type union {
              type inet:ipv4-address;
              type inet:ipv6-address;
            }
          }
          leaf port {
            type union {
              type uint16;
              type uint16;
            }
          }
        }
        leaf protection {
          type enumeration {
            enum "dhe-psk-aes128-cbc-sha1";
            enum "dhe-psk-aes256-cbc-sha1";
            enum "psk-aes128-cbc-sha1";
            enum "psk-aes256-cbc-sha1";
          }
        }
        list local-interface {
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "name";
          leaf name {
            type string;
          }
          leaf priority {
            type uint8;
          }
        }
        container psk {
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          leaf id {
            type string;
          }
          container key {
            tailf:cli-flatten-container;
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands;
            // NCS expand uses statement
            leaf encryption {
              tailf:cli-drop-node-name;
              tailf:cli-optional-in-sequence;
              type enumeration {
                enum "0";
                enum "6";
                enum "7";
              }
            }
            leaf secret {
              tailf:cli-drop-node-name;
              type string;
            }
          }
        }
        container overlay-address {
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          leaf address {
            tailf:cli-drop-node-name;
            type union {
              type inet:ipv4-address;
              type inet:ipv6-address;
            }
          }
          leaf vrf {
            type string;
          }
        }
        leaf shutdown {
          type empty;
        }
      }
      container engine {
        container compliance {
          container shield {
            leaf disable {
              type empty;
            }
          }
        }
      }
