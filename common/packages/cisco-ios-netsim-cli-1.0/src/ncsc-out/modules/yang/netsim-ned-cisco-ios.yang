    container track {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='netsim-ned-cisco-ios']";
      container timer {
        container interface {
          uses track-timer-grouping;
        }
        container ip {
          container route {
            uses track-timer-grouping;
          }
          container sla {
            uses track-timer-grouping;
          }
        }
        container ipv6 {
          container route {
            uses track-timer-grouping;
          }
        }
        container list {
          uses track-timer-grouping;
        }
        container stub-object {
          uses track-timer-grouping;
        }
      }
      container resolution {
        container ip {
          container route {
            leaf static {
              type uint32;
            }
            leaf EIGRP {
              tailf:cli-case-insensitive;
              type uint32;
            }
            leaf OSPF {
              tailf:cli-case-insensitive;
              type uint16;
            }
            leaf ISIS {
              tailf:cli-case-insensitive;
              type uint16;
            }
            leaf BGP {
              tailf:cli-case-insensitive;
              type uint32;
            }
          }
        }
