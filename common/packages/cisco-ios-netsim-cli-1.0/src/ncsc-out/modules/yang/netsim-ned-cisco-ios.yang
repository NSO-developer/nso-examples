              type uint16;
            }
            leaf vni {
              type uint32;
            }
          }
          leaf vni {
            type uint32;
          }
        }
      }
      list access-map {
        key "name number";
        leaf name {
          type string;
        }
        leaf number {
          type uint16;
        }
        container action {
