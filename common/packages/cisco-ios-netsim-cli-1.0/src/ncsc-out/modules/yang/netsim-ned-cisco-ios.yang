        leaf-list idle {
          tailf:cli-flat-list-syntax;
          ordered-by user;
          type enumeration {
            enum "Cfwdall";
            enum "ConfList";
            enum "Dnd";
            enum "Gpickup";
            enum "HLog";
            enum "Join";
            enum "Login";
            enum "Mobility";
            enum "Newcall";
            enum "Pickup";
            enum "Redial";
            enum "RmLstC";
          }
        }
        leaf-list seized {
          tailf:cli-flat-list-syntax;
          ordered-by user;
          type enumeration {
            enum "CWOff";
            enum "Callback";
            enum "Cfwdall";
            enum "Endcall";
            enum "Gpickup";
            enum "HLog";
            enum "Meetme";
            enum "Pickup";
            enum "Redial";
          }
        }
        leaf-list alerting {
          tailf:cli-flat-list-syntax;
          ordered-by user;
