              tailf:cli-delete-when-empty;
              key "name";
              leaf name {
                type string;
              }
            }
          }
        }
        choice qos-choice {
          container qos-enable {
            tailf:cli-drop-node-name;
            leaf qos {
              type boolean;
            }
          }
          container qos {
            container trust {
              tailf:cli-compact-syntax;
              choice trust-choice {
                leaf dscp {
                  type empty;
                }
                leaf cos {
                  type empty;
                }
                leaf device {
                  type enumeration {
                    enum "cisco-phone";
                    enum "cts";
                    enum "ip-camera";
                    enum "media-player";
                  }
                }
                container extend {
                  tailf:cli-delete-when-empty;
                  presence "true";
                  leaf cos {
                    type uint8;
                  }
                }
              }
            }
            leaf pre-classify {
              type empty;
            }
            container vlan-based {
              presence "true";
            }
            leaf dscp {
              type uint8;
            }
          }
        }
        container qos-config {
          container scheduling-mode {
            leaf min-bw-guarantee {
              type boolean;
            }
          }
        }
        list tx-queue {
          key "id";
          leaf id {
            type uint8;
          }
          container bandwidth {
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            choice bandwidth-choice {
              case numeric {
                leaf value {
                  tailf:cli-drop-node-name;
                  type string;
                }
                leaf unit {
                  tailf:cli-drop-node-name;
                  type string;
                }
              }
              leaf percent {
                type uint8;
              }
            }
          }
          container shape {
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            choice shape-choice {
              case numeric {
                leaf value {
                  tailf:cli-drop-node-name;
                  type string;
                }
                leaf unit {
                  tailf:cli-drop-node-name;
                  type string;
                }
              }
              leaf percent {
                type uint8;
              }
            }
          }
          leaf priority {
            type enumeration {
              enum "high";
            }
          }
        }
        container link {
          container state {
            container group {
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands {
                tailf:cli-reset-siblings;
              }
              leaf number {
                tailf:cli-drop-node-name;
                type uint8;
              }
              leaf direction {
                tailf:cli-drop-node-name;
                type enumeration {
                  enum "downstream";
                  enum "upstream";
                }
              }
            }
          }
        }
        container source {
          leaf template {
            type string;
          }
        }
        container l2protocol {
          choice l2protocol-choice {
            leaf drop {
              type empty;
            }
            leaf peer {
              type empty;
            }
            list protocols {
              tailf:cli-drop-node-name;
              tailf:cli-suppress-mode;
              tailf:cli-delete-when-empty;
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands;
              key "protocol";
              leaf protocol {
                type enumeration {
                  enum "cdp";
                  enum "dtp";
                  enum "lacp";
                  enum "stp";
                  enum "vtp";
                }
              }
              leaf option {
                tailf:cli-drop-node-name;
                tailf:cli-prefix-key;
                type enumeration {
                  enum "drop";
                  enum "peer";
                }
              }
            }
          }
        }
        container zone-member {
          leaf security {
            type string;
          }
        }
        container et-analytics {
          leaf enable {
            type empty;
          }
        }
        container srlg {
          list gid {
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "id";
            leaf id {
              type uint16;
            }
          }
        }
        container stackwise-virtual {
          leaf link {
            type uint8;
          }
          leaf dual-active-detection {
            type empty;
          }
        }
        container location {
          leaf civic-location-id {
            type union {
              type string;
              type enumeration {
                enum "host";
                enum "none";
              }
            }
          }
        }
        leaf bridge-group {
          type uint8;
        }
        container bridge-group-conf {
          tailf:cli-drop-node-name;
          list bridge-group {
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "id";
            leaf id {
              type uint8;
            }
            leaf subscriber-loop-control {
              type empty;
            }
            leaf block-unknown-source {
              type empty;
            }
            leaf source-learning {
              type boolean;
            }
            leaf unicast-flooding {
              type boolean;
            }
            leaf spanning-disabled {
              type empty;
            }
          }
        }
        leaf tx-ring-limit {
          type uint16;
        }
        leaf tx-queue-limit {
          type uint16;
        }
        container l2proto-forward {
          container tagged {
            presence "true";
          }
        }
        container tag-switching {
          container mtu {
            choice mtu-choice {
              leaf override {
                type uint16;
              }
              leaf value {
                tailf:cli-drop-node-name;
                type uint16;
              }
            }
          }
          leaf ip {
            type empty;
          }
        }
        container cws-tunnel {
          leaf in {
            type empty;
          }
          container out {
            leaf tunnel-number {
              type uint16;
            }
          }
        }
        container site-manager {
          container inside {
            presence "true";
          }
          container link-group {
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            leaf group {
              tailf:cli-drop-node-name;
              type string;
            }
            leaf direct-internet-access {
              type empty;
            }
          }
          container path {
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            leaf color {
              tailf:cli-drop-node-name;
              type string;
            }
            leaf direct-internet-access {
              type empty;
            }
          }
        }
        container cemoudp {
          container reserve {
            leaf bay {
              type uint8;
            }
          }
        }
        container topology {
          container ipv4 {
            container multicast {
              container base {
                tailf:cli-add-mode;
                container ip {
                  container ospf {
                    leaf cost {
                      type uint16;
                    }
                  }
                }
              }
            }
          }
        }
        uses interface-pointtopoint-grouping;
      }
      list ISM {
        tailf:cli-allow-join-with-key;
        tailf:cli-suppress-key-abbreviation;
        key "name";
        leaf name {
          type string;
        }
        uses interface-common-pre-grouping;
        uses interface-common-grouping;
        uses interface-pointtopoint-grouping;
      }
      list Analysis-Module {
        tailf:cli-allow-join-with-key;
        tailf:cli-suppress-key-abbreviation;
        key "name";
        leaf name {
          type string;
        }
        uses interface-common-pre-grouping;
        uses interface-common-grouping;
        uses interface-pointtopoint-grouping;
      }
      list Integrated-Service-Engine {
        tailf:cli-allow-join-with-key;
        tailf:cli-suppress-key-abbreviation;
        key "name";
        leaf name {
          type string;
        }
        uses interface-common-pre-grouping;
        uses interface-common-grouping;
        uses interface-pointtopoint-grouping;
      }
      list ATM {
        tailf:cli-allow-join-with-key;
        tailf:cli-suppress-key-abbreviation;
        key "name";
        leaf name {
          type string;
        }
        leaf point-to-point {
          tailf:cli-hide-in-submode;
          type empty;
        }
        uses interface-common-pre-grouping;
        uses interface-common-grouping;
        container bundle {
          list vc {
            tailf:cli-drop-node-name;
            key "name";
            leaf name {
              type string;
            }
            container oam {
              container retry {
                tailf:cli-compact-syntax;
                tailf:cli-sequence-commands;
                leaf up-count {
                  tailf:cli-drop-node-name;
                  type uint16;
                }
                leaf down-count {
                  tailf:cli-drop-node-name;
                  type uint16;
                }
                leaf retry-frequency {
                  tailf:cli-drop-node-name;
                  type uint16;
                }
              }
            }
            container encapsulation {
              choice encap-choice {
                container aal5mux {
                  leaf ip {
                    type empty;
                  }
                }
                leaf aal5snap {
                  type empty;
                }
              }
            }
            container oam-bundle {
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands {
                tailf:cli-reset-siblings;
              }
              leaf manage {
                tailf:cli-optional-in-sequence;
                type empty;
              }
              leaf frequency {
                tailf:cli-drop-node-name;
                type uint16;
              }
            }
          }
        }
        container ima {
          leaf version {
            type enumeration {
              enum "1.0";
              enum "1.1";
            }
          }
          leaf group-id {
            type uint8;
          }
        }
        container atm {
          container bandwidth {
            leaf dynamic {
              type empty;
            }
          }
          container mcpt-timers {
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            leaf timer-1 {
              tailf:cli-drop-node-name;
              type uint16;
            }
            leaf timer-2 {
              tailf:cli-drop-node-name;
              type uint16;
            }
            leaf timer-3 {
              tailf:cli-drop-node-name;
              type uint16;
            }
          }
          container oversubscribe {
            tailf:cli-delete-when-empty;
            presence "true";
            leaf factor {
              type uint8;
            }
          }
          leaf enable-ilmi-trap {
            type boolean;
          }
          container ilmi-keepalive {
            presence "true";
          }
          container route-bridged {
            leaf ip {
              type empty;
            }
            leaf ipv6 {
              type empty;
            }
          }
          container clock {
            leaf INTERNAL {
              type empty;
            }
          }
        }
        list pvc {
          tailf:cli-sequence-commands;
          key "name";
          leaf handle {
            tailf:cli-prefix-key;
            tailf:cli-drop-node-name;
            tailf:cli-optional-in-sequence;
            type uint32;
          }
          leaf name {
            tailf:cli-suppress-range;
            type string;
          }
          leaf l2transport {
            tailf:cli-hide-in-submode;
            type empty;
          }
          leaf class-vc {
            tailf:cli-break-sequence-commands;
            type string;
          }
          container vbr-nrt {
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            leaf pcr {
              tailf:cli-drop-node-name;
              type uint16;
            }
            leaf scr {
              tailf:cli-drop-node-name;
              type uint16;
            }
            leaf mbs {
              tailf:cli-drop-node-name;
              type uint16;
            }
          }
          leaf tx-limit {
            type uint32;
          }
          leaf tx-ring-limit {
            type uint8;
          }
          leaf vc-hold-queue {
            type uint16;
          }
          container cell-packing {
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            leaf maxcells {
              tailf:cli-drop-node-name;
              type uint8;
            }
            leaf mcpt-timer {
              type uint8;
            }
          }
          choice encap-choice {
            leaf encapsulation {
              type enumeration {
                enum "aal0";
                enum "aal5";
                enum "aal5snap";
                enum "aal5nlpid";
              }
            }
            container encapsulation-aal5mux {
              tailf:cli-drop-node-name;
              container encapsulation {
                tailf:cli-compact-syntax;
                tailf:cli-sequence-commands {
                  tailf:cli-reset-siblings;
                }
                leaf aal5mux {
                  type empty;
                }
                container ppp {
                  tailf:cli-flatten-container;
                  tailf:cli-compact-syntax;
                  leaf dialer {
                    type empty;
                  }
                }
              }
            }
          }
          container dialer {
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            presence "true";
            leaf pool-member {
              type uint8;
            }
          }
          container service-policy {
            uses service-policy-grouping;
          }
          uses pppoe-client-grouping;
          uses xconnect-grouping;
        }
      }
      list CEM {
        tailf:cli-allow-join-with-key;
        tailf:cli-suppress-key-abbreviation;
        key "name";
