<config xmlns="http://tail-f.com/ns/config/1.0">
  <core-network xmlns="http://tail-f.com/srlab/corenetwork">
    <services>
      <assurance-profile xmlns="http://tail-f.com/srlab/service-assurance">
        <name>transport-aa</name>
        <destination-address>192.0.2.10</destination-address>
        <destination-port>57500</destination-port>
        <encoding>self-describing-gpb</encoding>
        <sample-interval>30000</sample-interval>
        <source-interface>Loopback0</source-interface>
        <sensor-path>
          Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/
          interface/latest/generic-counters
        </sensor-path>
        <sensor-path>
          Cisco-IOS-XR-um-segment-routing-cfg:segment-routing/
          traffic-eng/policy
        </sensor-path>
        <sensor-path>
          Cisco-IOS-XR-um-performance-measurement-cfg:
          performance-measurement
        </sensor-path>
        <vendor-sensor-path>
          <vendor>junos</vendor>
          <path>/interfaces/interface/state/counters</path>
        </vendor-sensor-path>
        <vendor-sensor-path>
          <vendor>junos</vendor>
          <path>
            /network-instances/network-instance/protocols/protocol/
            bgp/neighbors/neighbor/state
          </path>
        </vendor-sensor-path>
        <vendor-sensor-path>
          <vendor>sros</vendor>
          <path>/state/port/statistics</path>
        </vendor-sensor-path>
        <vendor-sensor-path>
          <vendor>sros</vendor>
          <path>/state/router/interface/statistics</path>
        </vendor-sensor-path>
      </assurance-profile>
      <assurance-monitor xmlns="http://tail-f.com/srlab/service-assurance">
        <name>transport-domain</name>
        <profile>transport-aa</profile>
        <device>pe-01</device>
        <device>pe-02</device>
        <device>core-1</device>
        <monitored-service>transport-underlay</monitored-service>
        <service-assurance>
          <monitoring-state>active</monitoring-state>
          <profile-name>transport-domain</profile-name>
          <rule-name>underlay-visibility</rule-name>
          <preservation>historical</preservation>
        </service-assurance>
      </assurance-monitor>
    </services>
  </core-network>
</config>
