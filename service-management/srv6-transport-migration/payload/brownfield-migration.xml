<config xmlns="http://tail-f.com/ns/config/1.0">
  <network-slice-services xmlns="http://tail-f.com/ns/example/srv6-transport-migration/transport-slice-service">
    <slo-sle-templates>
      <slo-sle-template>
        <id>bf-gold-slo</id>
        <guaranteed-bandwidth>1000</guaranteed-bandwidth>
        <latency-bound>25</latency-bound>
        <isolation>dedicated</isolation>
        <pm-delay-profile>bf-delay</pm-delay-profile>
        <assurance-profile>transport-aa</assurance-profile>
        <service-assurance>
          <monitoring-state>active</monitoring-state>
          <profile-name>brownfield-gold</profile-name>
          <rule-name>slice-latency-slo</rule-name>
          <preservation>historical</preservation>
        </service-assurance>
      </slo-sle-template>
    </slo-sle-templates>
    <slice-service>
      <service-id>bf-gold</service-id>
      <description>Brownfield gold L3 slice over RSVP-TE</description>
      <customer>Tail-f</customer>
      <assurance-profile>transport-aa</assurance-profile>
      <service-assurance>
        <monitoring-state>active</monitoring-state>
        <profile-name>brownfield-gold</profile-name>
        <rule-name>end-to-end-sla</rule-name>
        <preservation>historical</preservation>
      </service-assurance>
      <sdp>
        <sdp-id>pe01</sdp-id>
        <attachment-circuit-id>pe-01-2</attachment-circuit-id>
        <ipv4-subnet>10.42.1.0/24</ipv4-subnet>
        <provider-ip-index>1</provider-ip-index>
        <customer-ip-index>2</customer-ip-index>
      </sdp>
      <sdp>
        <sdp-id>pe02</sdp-id>
        <attachment-circuit-id>pe-02-2</attachment-circuit-id>
        <ipv4-subnet>10.42.2.0/24</ipv4-subnet>
        <provider-ip-index>1</provider-ip-index>
        <customer-ip-index>2</customer-ip-index>
      </sdp>
      <connection-group>
        <connection-group-id>cg-l3</connection-group-id>
        <connectivity-type>l3vpn</connectivity-type>
        <sdp>pe01</sdp>
        <sdp>pe02</sdp>
        <slo-sle-template>bf-gold-slo</slo-sle-template>
        <transport-profile>rsvp-te</transport-profile>
        <rsvp-te>
          <tunnel-id>1234</tunnel-id>
        </rsvp-te>
        <metric-type>latency</metric-type>
        <sid-algorithm>128</sid-algorithm>
      </connection-group>
    </slice-service>
  </network-slice-services>
</config>
