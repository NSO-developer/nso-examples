<config xmlns="http://tail-f.com/ns/config/1.0">
  <core-network xmlns="http://tail-f.com/srlab/corenetwork">
    <services>
      <pm-profile
        xmlns="http://tail-f.com/srv6-transport-migration/transport-pm">
        <name>transport-gold</name>
        <device>pe-01</device>
        <device>pe-02</device>
        <device>core-1</device>
        <protocol-profile>
          <querier-src-port>862</querier-src-port>
          <querier-dst-port>862</querier-dst-port>
        </protocol-profile>
        <delay-profile>
          <name>gold-delay</name>
          <protocol>pm-mpls</protocol>
          <measurement-mode>two-way</measurement-mode>
          <tx-interval>10000</tx-interval>
          <computation-interval>30</computation-interval>
          <periodic-interval>30</periodic-interval>
          <periodic-threshold>10</periodic-threshold>
          <traffic-class>6</traffic-class>
        </delay-profile>
        <liveness-profile>
          <name>gold-live</name>
          <tx-interval>10000</tx-interval>
          <burst-interval>3000</burst-interval>
          <multiplier>3</multiplier>
        </liveness-profile>
        <interface-attachment>
          <device>pe-02</device>
          <interface>Gi0/0/0/0</interface>
          <next-hop>10.10.20.11</next-hop>
          <delay-profile>gold-delay</delay-profile>
          <advertise-delay>25</advertise-delay>
        </interface-attachment>
        <sr-policy-attachment>
          <device>pe-02</device>
          <policy-name>pe02-to-pe01</policy-name>
          <delay-profile>gold-delay</delay-profile>
          <liveness-profile>gold-live</liveness-profile>
          <invalidation-action>down</invalidation-action>
        </sr-policy-attachment>
        <odn-color-attachment>
          <device>pe-02</device>
          <color>3000</color>
          <delay-profile>gold-delay</delay-profile>
          <liveness-profile>gold-live</liveness-profile>
        </odn-color-attachment>
        <endpoint-attachment>
          <device>pe-02</device>
          <address>10.10.20.111</address>
          <source-address>10.10.20.112</source-address>
          <delay-profile>gold-delay</delay-profile>
          <liveness-profile>gold-live</liveness-profile>
        </endpoint-attachment>
        <endpoint-attachment>
          <device>pe-01</device>
          <address>10.10.20.112</address>
          <source-address>10.10.20.111</source-address>
          <delay-profile>gold-delay</delay-profile>
        </endpoint-attachment>
        <endpoint-attachment>
          <device>core-1</device>
          <address>10.10.20.102</address>
          <source-address>10.10.20.101</source-address>
          <delay-profile>gold-delay</delay-profile>
        </endpoint-attachment>
      </pm-profile>
    </services>
  </core-network>
</config>
