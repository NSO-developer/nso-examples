<config xmlns="http://tail-f.com/ns/config/1.0">
  <l3vpn-ntw xmlns="urn:ietf:params:xml:ns:yang:ietf-l3vpn-ntw">
    <vpn-services>
      <vpn-service>
        <vpn-id>l3nm-basic</vpn-id>
        <vpn-nodes>
          <vpn-node>
            <vpn-node-id>pe-01</vpn-node-id>
            <vpn-network-accesses>
              <vpn-network-access>
                <id>pe01-link</id>
                <interface-id>pe-01-2</interface-id>
                <ip-connection>
                  <ipv4>
                    <local-address>10.1.1.2</local-address>
                    <prefix-length>24</prefix-length>
                  </ipv4>
                </ip-connection>
              </vpn-network-access>
            </vpn-network-accesses>
          </vpn-node>
          <vpn-node>
            <vpn-node-id>pe-02</vpn-node-id>
            <vpn-network-accesses>
              <vpn-network-access>
                <id>pe02-link</id>
                <interface-id>pe-02-2</interface-id>
                <ip-connection>
                  <ipv4>
                    <local-address>10.1.2.2</local-address>
                    <prefix-length>24</prefix-length>
                  </ipv4>
                </ip-connection>
              </vpn-network-access>
              <vpn-network-access>
                <id>pe02-ce</id>
                <interface-id>pe-02-3</interface-id>
                <ip-connection>
                  <ipv4>
                    <local-address>10.1.3.2</local-address>
                    <prefix-length>24</prefix-length>
                  </ipv4>
                </ip-connection>
                <routing-protocols>
                  <routing-protocol>
                    <id>CE-BGP</id>
                    <type>bgp-routing</type>
                    <bgp>
                      <neighbor>10.1.3.3</neighbor>
                      <peer-as>65010</peer-as>
                    </bgp>
                  </routing-protocol>
                </routing-protocols>
              </vpn-network-access>
            </vpn-network-accesses>
          </vpn-node>
        </vpn-nodes>
      </vpn-service>
    </vpn-services>
  </l3vpn-ntw>
</config>
