<config xmlns="http://tail-f.com/ns/config/1.0">
  <te xmlns="urn:ietf:params:xml:ns:yang:ietf-te"
      xmlns:t="urn:ietf:params:xml:ns:yang:ietf-te-types"
      xmlns:tte="http://tail-f.com/ns/example/srv6-transport-migration/te-tunnel-extensions">
    <tunnels>
      <tunnel>
        <name>IETF-RSVP-TE</name>
        <identifier>1234</identifier>
        <description>RSVP_TE</description>
        <source>
          <te-node-id>10.10.20.111</te-node-id>
        </source>
        <tte:head-end>pe-01</tte:head-end>
        <destination>
          <te-node-id>10.10.20.112</te-node-id>
        </destination>
        <tte:tail-end>pe-02</tte:tail-end>
        <setup-priority>3</setup-priority>
        <hold-priority>2</hold-priority>
        <te-bandwidth>
          <generic>94967295</generic>
        </te-bandwidth>
        <signaling-type>t:path-setup-rsvp</signaling-type>
        <tte:fast-reroute/>
        <tte:traffic-steering>
          <tte:autoroute>
            <tte:announce>
              <tte:enable>true</tte:enable>
              <tte:metric>
                <tte:constant>15</tte:constant>
              </tte:metric>
            </tte:announce>
            <tte:destination>
              <tte:address>192.0.2.1</tte:address>
            </tte:destination>
          </tte:autoroute>
        </tte:traffic-steering>
        <primary-paths>
          <primary-path>
            <name>PATH-1</name>
<path-computation-method>t:path-explicitly-defined</path-computation-method>
            <preference>1</preference>
            <explicit-route-objects>
              <route-object-include-exclude>
                <index>1</index>
                <numbered-node-hop>
                  <node-id>10.10.20.101</node-id>
                  <hop-type>loose</hop-type>
                </numbered-node-hop>
              </route-object-include-exclude>
              <route-object-include-exclude>
                <index>2</index>
                <numbered-node-hop>
                  <node-id>10.10.20.102</node-id>
                  <hop-type>loose</hop-type>
                </numbered-node-hop>
              </route-object-include-exclude>
            </explicit-route-objects>
          </primary-path>
          <primary-path>
            <name>PATH-2</name>
<path-computation-method>t:path-locally-computed</path-computation-method>
            <optimizations>
              <optimization-metric>
                <metric-type>t:path-metric-te</metric-type>
              </optimization-metric>
            </optimizations>
            <preference>2</preference>
          </primary-path>
        </primary-paths>
      </tunnel>
    </tunnels>
  </te>
</config>
