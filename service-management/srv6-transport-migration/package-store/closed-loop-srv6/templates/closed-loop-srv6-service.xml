<config-template xmlns="http://tail-f.com/ns/config/1.0"
                 servicepoint="closed-loop-srv6-servicepoint"
                 componenttype="cls:service"
                 state="cls:configured">
  <devices xmlns="http://tail-f.com/ns/ncs">
    <device>
      <name>{/device}</name>
      <trace>pretty</trace>
      <config>
        <interface xmlns="http://tail-f.com/ned/cisco-ios-xr">
          <Loopback>
            <id>0</id>
            <ipv6>
              <address>
                <prefix-list>
                  <prefix>{/loopback0-prefix}</prefix>
                </prefix-list>
              </address>
            </ipv6>
          </Loopback>
          <Loopback>
            <id>1</id>
            <ipv6>
              <address>
                <prefix-list>
                  <prefix>{/loopback1-prefix}</prefix>
                </prefix-list>
              </address>
            </ipv6>
          </Loopback>
        </interface>
        <segment-routing xmlns="http://tail-f.com/ned/cisco-ios-xr">
          <srv6>
            <encapsulation>
              <source-address>{substring-before(/loopback1-prefix, "/")}</source-address>
            </encapsulation>
            <locators>
              <locator>
                <name>{/locator-name}</name>
                <micro-segment>
                  <behavior>
                    <unode>psp-usd</unode>
                  </behavior>
                </micro-segment>
                <prefix>{/srv6-prefix}</prefix>
              </locator>
            </locators>
          </srv6>
        </segment-routing>
        <router xmlns="http://tail-f.com/ned/cisco-ios-xr">
          <isis>
            <tag>
              <name>1</name>
              <is-type>level-2-only</is-type>
              <net>
                <id>{/isis-net}</id>
              </net>
              <log>
                <adjacency>
                  <changes/>
                </adjacency>
              </log>
              <address-family>
                <ipv6>
                  <unicast>
                    <metric-style>wide</metric-style>
                    <segment-routing>
                      <srv6>
                        <locator>
                          <name>{/locator-name}</name>
                        </locator>
                      </srv6>
                    </segment-routing>
                  </unicast>
                </ipv6>
              </address-family>
              <interface>
                <name>Loopback0</name>
                <interface-type>passive</interface-type>
                <address-family>
                  <ipv6>
                    <unicast/>
                  </ipv6>
                </address-family>
              </interface>
              <interface>
                <name>Loopback1</name>
                <interface-type>passive</interface-type>
                <address-family>
                  <ipv6>
                    <unicast/>
                  </ipv6>
                </address-family>
              </interface>
            </tag>
          </isis>
        </router>
      </config>
    </device>
  </devices>
</config-template>
