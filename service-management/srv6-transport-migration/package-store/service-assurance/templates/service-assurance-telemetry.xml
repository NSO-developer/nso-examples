<config-template xmlns="http://tail-f.com/ns/config/1.0">
  <devices xmlns="http://tail-f.com/ns/ncs">
    <device>
      <name>{$DEVICE}</name>
      <config>
        <telemetry xmlns="http://tail-f.com/ned/cisco-ios-xr">
          <model-driven>
            <destination-group>
              <id>{$DESTINATION_GROUP}</id>
              <address-family>
                <ipv4>
                  <address>{$DESTINATION_ADDRESS}</address>
                  <port>{$DESTINATION_PORT}</port>
                  <encoding>{$ENCODING}</encoding>
                  <protocol>
                    <grpc>
                      <no-tls/>
                    </grpc>
                  </protocol>
                </ipv4>
              </address-family>
            </destination-group>
            <sensor-group>
              <id>{$SENSOR_GROUP}</id>
            </sensor-group>
            <subscription>
              <id>{$SUBSCRIPTION}</id>
              <sensor-group-id>
                <name>{$SENSOR_GROUP}</name>
                <sample-interval>{$SAMPLE_INTERVAL}</sample-interval>
              </sensor-group-id>
              <destination-id>
                <name>{$DESTINATION_GROUP}</name>
              </destination-id>
              <source-interface>
                <Loopback>
                  {substring-after($SOURCE_INTERFACE, 'Loopback')}
                </Loopback>
              </source-interface>
            </subscription>
          </model-driven>
        </telemetry>
        <configuration xmlns="http://xml.juniper.net/xnm/1.1/xnm">
          <services>
            <analytics>
              <streaming-server>
                <name>{$DESTINATION_GROUP}</name>
                <remote-address>{$DESTINATION_ADDRESS}</remote-address>
                <remote-port>{$DESTINATION_PORT}</remote-port>
                <transport>grpc</transport>
              </streaming-server>
              <export-profile>
                <name>{$DESTINATION_GROUP}</name>
                <format>{$JUNOS_FORMAT}</format>
                <transport>grpc</transport>
                <reporting-rate>{$SAMPLE_SECONDS}</reporting-rate>
              </export-profile>
            </analytics>
          </services>
        </configuration>
        <system xmlns="http://tail-f.com/ned/alu-sr">
          <grpc>
            <allow-unsecure-connection/>
            <gnmi>
              <shutdown>false</shutdown>
            </gnmi>
            <shutdown>false</shutdown>
          </grpc>
          <telemetry>
            <destination-group>
              <name>{$DESTINATION_GROUP}</name>
              <allow-unsecure-connection/>
              <destination>
                <address>{$DESTINATION_ADDRESS}</address>
                <port>{$DESTINATION_PORT}</port>
                <router-instance>
                  <router-id>Base</router-id>
                </router-instance>
              </destination>
            </destination-group>
            <sensor-groups>
              <sensor-group>
                <name>{$SENSOR_GROUP}</name>
                <description>NSO service-assurance sensors</description>
              </sensor-group>
            </sensor-groups>
            <persistent-subscriptions>
              <subscription>
                <name>{$SUBSCRIPTION}</name>
                <description>NSO service-assurance subscription</description>
                <encoding>{$SROS_ENCODING}</encoding>
                <sample-interval>{$SAMPLE_INTERVAL}</sample-interval>
                <destination-group>{$DESTINATION_GROUP}</destination-group>
                <mode>sample</mode>
                <sensor-group>{$SENSOR_GROUP}</sensor-group>
                <shutdown>false</shutdown>
              </subscription>
            </persistent-subscriptions>
          </telemetry>
        </system>
      </config>
    </device>
  </devices>
</config-template>
