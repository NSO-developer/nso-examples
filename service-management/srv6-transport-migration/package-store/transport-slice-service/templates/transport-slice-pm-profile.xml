<config-template xmlns="http://tail-f.com/ns/config/1.0">
  <core-network xmlns="http://tail-f.com/srlab/corenetwork">
    <services>
      <pm-profile
        xmlns="http://tail-f.com/srv6-transport-migration/transport-pm">
        <name>{$PM_NAME}</name>
        <device>{$DEVICE}</device>
        <delay-profile>
          <name>{$DELAY_PROFILE}</name>
          <protocol>pm-mpls</protocol>
          <measurement-mode>two-way</measurement-mode>
          <tx-interval>10000</tx-interval>
          <computation-interval>30</computation-interval>
          <periodic-interval>30</periodic-interval>
          <periodic-threshold>{$LATENCY_BOUND}</periodic-threshold>
        </delay-profile>
        <interface-attachment>
          <device>{$DEVICE}</device>
          <interface>{$INTERFACE}</interface>
          <next-hop>{$NEXT_HOP}</next-hop>
          <delay-profile>{$DELAY_PROFILE}</delay-profile>
          <advertise-delay>{$LATENCY_BOUND}</advertise-delay>
        </interface-attachment>
      </pm-profile>
    </services>
  </core-network>
</config-template>
