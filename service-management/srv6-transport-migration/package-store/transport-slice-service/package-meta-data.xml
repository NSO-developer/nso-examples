<ncs-package xmlns="http://tail-f.com/ns/ncs-packages">
  <name>transport-slice-service</name>
  <package-version>1.0</package-version>
  <description>Network Slice Service composition example</description>

  <ncs-min-version>6.7</ncs-min-version>
  <required-package>
    <name>inventory</name>
  </required-package>
  <required-package>
    <name>l2vpn-service</name>
  </required-package>
  <required-package>
    <name>l3vpn-service</name>
  </required-package>
  <required-package>
    <name>transport-te</name>
  </required-package>
  <required-package>
    <name>service-assurance</name>
  </required-package>
  <required-package>
    <name>transport-pm</name>
  </required-package>
  <supported-ned-id-match>cisco-iosxr-netsim-cli.*</supported-ned-id-match>
  <supported-ned-id-match>cisco-iosxr-netsim-nc.*</supported-ned-id-match>
  <supported-ned-id-match>juniper-junos-netsim-nc.*</supported-ned-id-match>

  <component>
    <name>main</name>
    <application>
      <python-class-name>transport_slice_service.main.Main</python-class-name>
    </application>
  </component>
</ncs-package>
