<config-template xmlns="http://tail-f.com/ns/config/1.0">
  <devices xmlns="http://tail-f.com/ns/ncs">
    <device>
      <name>{$HEAD_END}</name>
      <config>
        <explicit-path xmlns="http://tail-f.com/ned/cisco-ios-xr">
          <name>
            <pathname>{$EXPLICIT_NAME}</pathname>
            <index>
              <index-id>{$INDEX}</index-id>
              <keyword>{$KEYWORD}</keyword>
              <?if {$HOP_TYPE}?>
                <hop-type>{$HOP_TYPE}</hop-type>
              <?end?>
              <?if {$NODE_ID}?>
                <ipv4>
                  <unicast>{$NODE_ID}</unicast>
                </ipv4>
              <?end?>
              <?if {$LABEL}?>
                <label>{$LABEL}</label>
              <?end?>
            </index>
          </name>
        </explicit-path>
        <configuration xmlns="http://xml.juniper.net/xnm/1.1/xnm">
          <protocols>
            <mpls>
              <path>
                <name>{$EXPLICIT_NAME}</name>
                <path-list>
                  <name>{$NODE_ID}</name>
                  <?if {$HOP_TYPE = 'loose'}?>
                    <loose/>
                  <?end?>
                  <?if {$HOP_TYPE = 'strict'}?>
                    <strict/>
                  <?end?>
                </path-list>
              </path>
            </mpls>
          </protocols>
        </configuration>
      </config>
    </device>
  </devices>
</config-template>
